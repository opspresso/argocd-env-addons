{
  "uid": "workspace-capacity",
  "title": "Workspace Capacity",
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "tags": [
    "kubernetes",
    "workspaces",
    "capacity"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kube_resourcequota, cluster)",
          "refId": "cluster"
        },
        "refresh": 1,
        "current": {
          "text": "eks-demo",
          "value": "eks-demo"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Workspace Pod quota used",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(max by (resource) (kube_resourcequota{namespace=\"agent-forge-workspaces\",cluster=\"$cluster\",type=\"used\",resource=\"pods\"})) / sum(max by (resource) (kube_resourcequota{namespace=\"agent-forge-workspaces\",cluster=\"$cluster\",type=\"hard\",resource=\"pods\"}))",
          "legendFormat": "Value"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "Used / hard Pod quota in agent-forge-workspaces. The Prometheus rule ForgeSandboxQuota fires above 80% for 5 minutes."
    },
    {
      "id": 2,
      "title": "Workspace Pods allocated",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (resource) (kube_resourcequota{namespace=\"agent-forge-workspaces\",cluster=\"$cluster\",type=\"used\",resource=\"pods\"}))",
          "legendFormat": "Value"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "Workspace Pods counted against the agent-forge-workspaces Pod quota."
    },
    {
      "id": 3,
      "title": "Workspace nodes",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kube_node_labels{cluster=\"$cluster\",label_karpenter_sh_nodepool=\"workspaces\"}) or (0 * sum(max by (resource) (kube_resourcequota{namespace=\"agent-forge-workspaces\",cluster=\"$cluster\",type=\"hard\",resource=\"pods\"})))",
          "legendFormat": "Value"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "Nodes in the workspaces node pool. 0 on EKS Auto Mode clusters that run workspaces on the shared node pool."
    },
    {
      "id": 4,
      "title": "Studio Agent execution load",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(agent_studio_active_execution_requests{cluster=\"$cluster\",namespace=\"agent-studio\"})",
          "legendFormat": "Value"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "Agent executions in progress in agent-studio."
    },
    {
      "id": 5,
      "title": "Workspace Pod phases",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase) (kube_pod_status_phase{namespace=\"agent-forge-workspaces\",cluster=\"$cluster\"})",
          "legendFormat": "{{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No workspace Pods"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "Workspace Pods by phase. Empty when no workspace Pod exists."
    },
    {
      "id": 6,
      "title": "Namespace resource quota usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * max by (resource) (kube_resourcequota{namespace=\"agent-forge-workspaces\",cluster=\"$cluster\",type=\"used\"}) / max by (resource) (kube_resourcequota{namespace=\"agent-forge-workspaces\",cluster=\"$cluster\",type=\"hard\"})",
          "legendFormat": "{{resource}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "Used / hard for each resource quota in agent-forge-workspaces."
    },
    {
      "id": 7,
      "title": "Sandbox CPU by Pod",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"agent-forge-workspaces\",cluster=\"$cluster\",container=\"sandbox\",image!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0,
          "noValue": "No sandbox running"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "CPU cores used by each sandbox container. Empty when no sandbox runs."
    },
    {
      "id": 8,
      "title": "Sandbox memory by Pod",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod) (container_memory_working_set_bytes{namespace=\"agent-forge-workspaces\",cluster=\"$cluster\",container=\"sandbox\",image!=\"\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "No sandbox running"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "Working set memory of each sandbox container. Empty when no sandbox runs."
    },
    {
      "id": 10,
      "title": "Workspace node memory used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{cluster=\"$cluster\"} / node_memory_MemTotal_bytes{cluster=\"$cluster\"}) and on(cluster,node) kube_node_labels{cluster=\"$cluster\",label_karpenter_sh_nodepool=\"workspaces\"}",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No workspaces node pool"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "Host memory used on nodes of the workspaces node pool. Empty when the cluster has no such node pool."
    },
    {
      "id": 11,
      "title": "Forge native model requests",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(agent_forge_active_model_requests{cluster=\"$cluster\",namespace=\"agent-forge\"})",
          "legendFormat": "Value"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "Model requests in progress in the Forge native runtime."
    },
    {
      "id": 12,
      "title": "Forge API / worker available replicas",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kube_deployment_status_replicas_available{cluster=\"$cluster\",namespace=\"agent-forge\",deployment=\"agent-forge\"})",
          "legendFormat": "Value"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "Available replicas of the agent-forge Deployment, which serves the API and execution worker."
    },
    {
      "id": 13,
      "title": "Knowledge worker available replicas",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kube_deployment_status_replicas_available{cluster=\"$cluster\",namespace=\"agent-knowledge\",deployment=\"agent-knowledge-worker\"})",
          "legendFormat": "Value"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "Available replicas of agent-knowledge-worker, which processes document and audio jobs."
    }
  ],
  "links": [
    {
      "title": "Cluster Overview",
      "type": "link",
      "url": "/d/cluster-overview",
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "tooltip": ""
    },
    {
      "title": "Service Status",
      "type": "link",
      "url": "/d/service-status",
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "tooltip": ""
    }
  ]
}
