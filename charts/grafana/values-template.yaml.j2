grafana:
  fullnameOverride: grafana

{% if resources is defined and not resources.enabled %}
  resources:
    limits: null
    requests: null
  initChownData:
    resources: null
  downloadDashboards:
    resources: null
  testFramework:
    resources: null
{% endif %}

{% if autoscaling is defined %}
  autoscaling:
    enabled: {{autoscaling.enabled}}
{% endif %}

{% if grafana is defined %}
  # Use the committed dashboard revision; branch URLs can return stale JSON.
{% if env == 'k3s' %}
  dashboards:
    managed: null
    alpha:
      kube-cluster:
        url: https://raw.githubusercontent.com/opspresso/argocd-env-addons/{{grafana_dashboard_revision}}/charts/grafana/dashboards/kube-cluster.json
      kube-workload:
        url: https://raw.githubusercontent.com/opspresso/argocd-env-addons/{{grafana_dashboard_revision}}/charts/grafana/dashboards/kube-workload.json
      workspace-capacity:
        url: https://raw.githubusercontent.com/opspresso/argocd-env-addons/{{grafana_dashboard_revision}}/charts/grafana/dashboards/workspace-capacity.json
      argo-cd:
        url: https://raw.githubusercontent.com/argoproj/argo-cd/refs/heads/master/examples/dashboard.json
        datasource: Prometheus
  dashboardProviders:
    dashboardproviders.yaml:
      apiVersion: 1
      providers:
        - name: alpha
          orgId: 1
          folder: ''
          type: file
          disableDeletion: false
          editable: true
          options:
            path: /var/lib/grafana/dashboards/alpha
{% else %}
  dashboards:
    managed:
      cluster-overview:
        url: https://raw.githubusercontent.com/opspresso/argocd-env-addons/{{grafana_dashboard_revision}}/charts/grafana/dashboards/cluster-overview.json
      service-status:
        url: https://raw.githubusercontent.com/opspresso/argocd-env-addons/{{grafana_dashboard_revision}}/charts/grafana/dashboards/service-status.json
      kube-cluster:
        url: https://raw.githubusercontent.com/opspresso/argocd-env-addons/{{grafana_dashboard_revision}}/charts/grafana/dashboards/kube-cluster.json
      kube-workload:
        url: https://raw.githubusercontent.com/opspresso/argocd-env-addons/{{grafana_dashboard_revision}}/charts/grafana/dashboards/kube-workload.json
      workspace-capacity:
        url: https://raw.githubusercontent.com/opspresso/argocd-env-addons/{{grafana_dashboard_revision}}/charts/grafana/dashboards/workspace-capacity.json
{% endif %}

{% if env == 'k3s' %}
  # Alpha is for resource inspection; production owns alert delivery.
  alerting: null
  envValueFrom: null
{% else %}
  alerting:
    workload-health.yaml:
      secret:
{{ workload_health_alerting | to_yaml | indent(8, first=true) }}
{% if env == 'eks' %}
  # These target names and host collectors belong to the EKS Prometheus stack.
  # Keep k3s/VictoriaMetrics from alerting on exporters it does not run.
    node-health.yaml:
      secret:
{{ node_health_alerting | to_yaml | indent(8, first=true) }}
    cni-health.yaml:
      secret:
{{ cni_health_alerting | to_yaml | indent(8, first=true) }}
    workspace-notifications.yaml:
      secret:
{{ workspace_notifications | to_yaml | indent(8, first=true) }}
{% endif %}
{% endif %}
{% if grafana.persistence is defined %}
  persistence:
    enabled: {{grafana.persistence.enabled}}
{% if grafana.persistence.size is defined %}
    size: {{grafana.persistence.size}}
{% endif %}
{% if grafana.persistence.storageClassName is defined %}
    storageClassName: "{{grafana.persistence.storageClassName}}"
{% endif %}
{% endif %}

  podAnnotations:
    link.argocd.argoproj.io/external-link: "https://{{grafana.hostname}}"
    # Keep changes to the canonical dashboard files visible to the rollout.
    checksum/managed-dashboards: "{{grafana_dashboard_checksum}}"

  grafana.ini:
{% if env == 'k3s' %}
    unified_alerting:
      enabled: false
{% endif %}
    server:
      root_url: "https://{{grafana.hostname}}/"
{% if env != 'k3s' %}
    # Users land on the overview; the file is written by the dashboard download.
    dashboards:
      default_home_dashboard_path: /var/lib/grafana/dashboards/managed/cluster-overview.json
{% endif %}

{% if grafana.auth.github.enabled %}
    # https://grafana.com/docs/grafana/latest/auth/github/
    auth.github:
      enabled: {{grafana.auth.github.enabled}}
      allow_sign_up: true
      client_id: $__file{/etc/secrets/grafana-secret/github-id}
      client_secret: $__file{/etc/secrets/grafana-secret/github-secret}
      scopes: user:email,read:org
      auth_url: https://github.com/login/oauth/authorize
      token_url: https://github.com/login/oauth/access_token
      api_url: https://api.github.com/user
      allowed_organizations: {{grafana.auth.github.org}}
{% if grafana.auth.github.team is defined %}
      # GitHub reports team membership as groups "@<org>/<team>". The role syncs on every login.
      role_attribute_path: "contains(groups[*], '@{{grafana.auth.github.org}}/{{grafana.auth.github.team}}') && 'Admin' || 'Viewer'"
{% endif %}
{% endif %}

{% if grafana.auth.google.enabled %}
    # https://grafana.com/docs/grafana/latest/auth/google/
    auth.google:
      enabled: {{grafana.auth.google.enabled}}
      allow_sign_up: true
      client_id: $__file{/etc/secrets/grafana-secret/google-id}
      client_secret: $__file{/etc/secrets/grafana-secret/google-secret}
      scopes: https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/userinfo.email
      auth_url: https://accounts.google.com/o/oauth2/auth
      token_url: https://accounts.google.com/o/oauth2/token
      allowed_domains: {{grafana.auth.google.allowed_domains}}
{% endif %}

  ingress:
    enabled: false

  route:
    main:
      enabled: true
      annotations:
        link.argocd.argoproj.io/external-link: "https://{{grafana.hostname}}"
      parentRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
{% if gateway is defined %}
          name: "{{gateway.name}}"
          namespace: "{{gateway.namespace}}"
{% else %}
          name: istio-ingressgateway
          namespace: istio-system
{% endif %}
      hostnames:
        - "{{grafana.hostname}}"

  datasources:
    datasources.yaml:
      apiVersion: 1
      # Grafana cannot change the uid of a datasource it has already stored: the
      # update path re-reads the row by the uid written here, misses, and fails
      # provisioning hard enough to take the process down with it. Dropping the
      # rows first sends provisioning down the insert path, which honours the
      # uids below. Grafana skips the delete event for a name that is recreated
      # in the same pass, so nothing downstream sees the datasource disappear.
      deleteDatasources:
        - name: Prometheus
          orgId: 1
{% if loki is defined %}
        - name: Loki
          orgId: 1
{% endif %}

      datasources:
      # The uids are pinned because the provisioned alert rules in values.yaml
      # reference them; grafana assigns a random uid otherwise and every rule
      # lands on a datasource that does not exist.
      - name: Prometheus
        type: prometheus
        uid: prometheus
{% if metrics is defined and metrics.backend == 'victoria-metrics' %}
        url: http://vmsingle-victoria-metrics.addon-victoria-metrics.svc.cluster.local:8428
{% else %}
        url: http://prometheus-prometheus.addon-prometheus.svc.cluster.local:9090
{% endif %}
        access: proxy
        isDefault: true
{% if loki is defined %}
      - name: Loki
        type: loki
        uid: loki
        url: http://{{loki.hostname}}
        access: proxy
{% endif %}
{% if grafana.datasource is defined %}
{% if grafana.datasource.demo is defined %}
      - name: demo
        type: prometheus
        url: {{grafana.datasource.demo}}
        access: proxy
{% endif %}
{% if grafana.datasource.demo_a is defined %}
      - name: demo-a
        type: prometheus
        url: {{grafana.datasource.demo_a}}
        access: proxy
{% endif %}
{% if grafana.datasource.demo_b is defined %}
      - name: demo-b
        type: prometheus
        url: {{grafana.datasource.demo_b}}
        access: proxy
{% endif %}
{% endif %}

  serviceMonitor:
{% if metrics is defined and metrics.backend == 'victoria-metrics' %}
    enabled: false
{% else %}
    enabled: {{prometheus.serviceMonitor.enabled}}
{% endif %}
    labels:
{% if metrics is defined and metrics.backend == 'victoria-metrics' %}
      release: victoria-metrics-{{cluster}}
{% else %}
      release: prometheus-{{cluster}}
{% endif %}

raw:
  resources:
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: grafana-secret
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: grafana-secret
        data:
          - secretKey: admin-user
            remoteRef:
              key: /k8s/common/admin-user
          - secretKey: admin-password
            remoteRef:
              key: /k8s/common/admin-password
{% if env != 'k3s' %}
          # Read through the SLACK_WEBHOOK_URL env var, not a file mount: the
          # alerting provisioning files interpolate $VAR but cannot read files.
          - secretKey: slack-webhook
            remoteRef:
              key: /k8s/common/slack-webhook/grafana
{% endif %}
{% if grafana.auth.github.enabled %}
          - secretKey: github-id
            remoteRef:
              key: /k8s/{{grafana.auth.github.org}}/grafana-github-id
          - secretKey: github-secret
            remoteRef:
              key: /k8s/{{grafana.auth.github.org}}/grafana-github-secret
{%- endif %}
{%- if grafana.auth.google.enabled %}
          - secretKey: google-id
            remoteRef:
              key: /common/google/client_id
          - secretKey: google-secret
            remoteRef:
              key: /common/google/client_secret
{%- endif %}
{%- endif %}
