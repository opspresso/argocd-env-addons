grafana:
  fullnameOverride: grafana

{% if resources is defined and not resources.enabled %}
  resources:
    limits: null
    requests: null
  initChownData:
    resources: null
  downloadDashboards:
    resources: null
  testFramework:
    resources: null
{% endif %}

{% if autoscaling is defined %}
  autoscaling:
    enabled: {{autoscaling.enabled}}
{% endif %}

{% if grafana is defined %}
  alerting:
    workload-health.yaml:
      secret:
{{ workload_health_alerting | to_yaml | indent(8, first=true) }}
{% if env == 'eks' %}
  # These target names and host collectors belong to the EKS Prometheus stack.
    node-health.yaml:
      secret:
{{ node_health_alerting | to_yaml | indent(8, first=true) }}
    cni-health.yaml:
      secret:
{{ cni_health_alerting | to_yaml | indent(8, first=true) }}
    workspace-notifications.yaml:
      secret:
{{ workspace_notifications | to_yaml | indent(8, first=true) }}
{% endif %}
{% if grafana.persistence is defined %}
  persistence:
    enabled: {{grafana.persistence.enabled}}
{% if grafana.persistence.size is defined %}
    size: {{grafana.persistence.size}}
{% endif %}
{% if grafana.persistence.storageClassName is defined %}
    storageClassName: "{{grafana.persistence.storageClassName}}"
{% endif %}
{% endif %}

  podAnnotations:
    link.argocd.argoproj.io/external-link: "https://{{grafana.hostname}}"

  grafana.ini:
    server:
      root_url: "https://{{grafana.hostname}}/"
    # Users land on the overview, mounted from the bundled dashboards ConfigMap.
    dashboards:
      default_home_dashboard_path: /var/lib/grafana/dashboards/managed/cluster-overview.json

{% if grafana.auth.dex.enabled or grafana.auth.google.enabled %}
    # Sign-in only through the OAuth provider: the username/password form is hidden.
    # The local admin account (grafana-secret) still works for the HTTP API.
    auth:
      disable_login_form: true
{% endif %}
{% if grafana.auth.dex.enabled %}
      # A user keeps one account across sign-in sources (GitHub, Kanidm): Grafana
      # finds it by email. Dex accepts only the sso groups.
      oauth_allow_insecure_email_lookup: true
    # Sign-in through Argo CD Dex (client grafana-sso), like the other addons.
    # https://grafana.com/docs/grafana/latest/setup-grafana/configure-security/configure-authentication/generic-oauth/
    auth.generic_oauth:
      enabled: true
      name: Kanidm
      icon: signin
      allow_sign_up: true
      auto_login: true
      client_id: grafana-sso
      client_secret: $__file{/etc/secrets/grafana-secret/oidc-client-secret}
      scopes: openid profile email groups
      auth_url: https://{{argocd.hostname}}/api/dex/auth
      token_url: https://{{argocd.hostname}}/api/dex/token
      api_url: https://{{argocd.hostname}}/api/dex/userinfo
      use_pkce: true
      login_attribute_path: preferred_username
      groups_attribute_path: groups
      # sso.admin_groups are Admin, other users Viewer. The role syncs on every login.
      role_attribute_path: "({% for g in sso.admin_groups %}contains(groups[*], '{{g}}'){% if not loop.last %} || {% endif %}{% endfor %}) && 'Admin' || 'Viewer'"
{% endif %}

{% if grafana.auth.google.enabled %}
    # https://grafana.com/docs/grafana/latest/auth/google/
    auth.google:
      enabled: {{grafana.auth.google.enabled}}
      allow_sign_up: true
      client_id: $__file{/etc/secrets/grafana-secret/google-id}
      client_secret: $__file{/etc/secrets/grafana-secret/google-secret}
      scopes: https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/userinfo.email
      auth_url: https://accounts.google.com/o/oauth2/auth
      token_url: https://accounts.google.com/o/oauth2/token
      allowed_domains: {{grafana.auth.google.allowed_domains}}
{% endif %}

  ingress:
    enabled: false

  route:
    main:
      enabled: true
      annotations:
        link.argocd.argoproj.io/external-link: "https://{{grafana.hostname}}"
      parentRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
{% if gateway is defined %}
          name: "{{gateway.name}}"
          namespace: "{{gateway.namespace}}"
{% else %}
          name: istio-ingressgateway
          namespace: istio-system
{% endif %}
      hostnames:
        - "{{grafana.hostname}}"

  datasources:
    datasources.yaml:
      apiVersion: 1
      # Grafana cannot change the uid of a datasource it has already stored: the
      # update path re-reads the row by the uid written here, misses, and fails
      # provisioning hard enough to take the process down with it. Dropping the
      # rows first sends provisioning down the insert path, which honours the
      # uids below. Grafana skips the delete event for a name that is recreated
      # in the same pass, so nothing downstream sees the datasource disappear.
      deleteDatasources:
        - name: Prometheus
          orgId: 1
{% if loki is defined %}
        - name: Loki
          orgId: 1
{% endif %}

      datasources:
      # The uids are pinned because the provisioned alert rules in values.yaml
      # reference them; grafana assigns a random uid otherwise and every rule
      # lands on a datasource that does not exist.
      - name: Prometheus
        type: prometheus
        uid: prometheus
        url: http://prometheus-prometheus.addon-prometheus.svc.cluster.local:9090
        access: proxy
        isDefault: true
{% if loki is defined %}
      - name: Loki
        type: loki
        uid: loki
        url: http://{{loki.hostname}}
        access: proxy
{% endif %}
{% if grafana.datasource is defined %}
{% if grafana.datasource.demo is defined %}
      - name: demo
        type: prometheus
        url: {{grafana.datasource.demo}}
        access: proxy
{% endif %}
{% if grafana.datasource.demo_a is defined %}
      - name: demo-a
        type: prometheus
        url: {{grafana.datasource.demo_a}}
        access: proxy
{% endif %}
{% if grafana.datasource.demo_b is defined %}
      - name: demo-b
        type: prometheus
        url: {{grafana.datasource.demo_b}}
        access: proxy
{% endif %}
{% endif %}

  serviceMonitor:
    enabled: {{prometheus.serviceMonitor.enabled}}
    labels:
      release: prometheus-{{cluster}}

raw:
  resources:
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: grafana-secret
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: grafana-secret
        data:
          - secretKey: admin-user
            remoteRef:
              key: /k8s/common/admin-user
          - secretKey: admin-password
            remoteRef:
              key: /k8s/common/admin-password
          # Read through the KEEP_API_KEY env var, not a file mount: the
          # alerting provisioning files interpolate $VAR but cannot read files.
          - secretKey: keep-api-key
            remoteRef:
              key: /k8s/common/keep/grafana-api-key
{% if grafana.auth.dex.enabled %}
          # Shared with the grafana-sso client of Argo CD Dex (charts/argo-cd).
          - secretKey: oidc-client-secret
            remoteRef:
              key: /k8s/common/grafana/oidc-client-secret
{%- endif %}
{%- if grafana.auth.google.enabled %}
          - secretKey: google-id
            remoteRef:
              key: /common/google/client_id
          - secretKey: google-secret
            remoteRef:
              key: /common/google/client_secret
{%- endif %}
{%- endif %}
