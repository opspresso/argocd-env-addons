{% if keep is defined %}
keep:
  backend:
    env:
      - name: SECRET_MANAGER_TYPE
        value: k8s
      - name: PORT
        value: "8080"
      - name: PROMETHEUS_MULTIPROC_DIR
        value: /tmp/prometheus
      # Grafana and Argo CD send alerts to this in-cluster address. Keep also
      # prints it in the webhook instructions of the providers page.
      - name: KEEP_API_URL
        value: http://keep-backend.addon-keep.svc.cluster.local:8080
      # No websocket server: Soketi takes its app secret only as a plain value.
      # The UI refreshes by polling.
      - name: PUSHER_DISABLED
        value: "true"
      - name: POSTHOG_DISABLED
        value: "true"
      - name: AUTH_TYPE
        value: OIDC
      - name: KEEP_OIDC_ISSUER
        value: "https://{{argocd.hostname}}/api/dex"
      - name: KEEP_OIDC_CLIENT_ID
        value: keep-sso
      # Dex reports GitHub teams as "<org>:<team>". A user in no listed group gets 403.
      - name: KEEP_OIDC_ADMIN_ROLES
        value: "{{argocd.github.org}}:{{argocd.github.team}}"

    # KEEP_PROVIDERS. Keep reconciles these at startup and removes provisioned
    # providers that are not listed. "$(NAME)" is replaced with the env var NAME.
    # install_webhook stays false: Grafana alerting and Argo CD notifications are
    # provisioned from this repository, and Keep would rewrite them.
    provision:
      providers:
        # No prometheus provider: Alertmanager pushes alerts with send_resolved.
        # Pulled alerts get a different fingerprint and never resolve.
{% if loki is defined %}
        loki:
          type: grafana_loki
          install_webhook: false
          authentication:
            host_url: http://loki.addon-loki.svc.cluster.local:3100
            authentication_type: NoAuth
{% endif %}
        argocd:
          type: argocd
          install_webhook: false
          authentication:
            deployment_url: http://argocd-server.argocd.svc.cluster.local
            argocd_access_token: "$(ARGOCD_ACCESS_TOKEN)"
        # Incoming webhook of the Slack app "Keep" in the nalbam workspace. The
        # webhook is bound to its channel (#noti-eks-demo) when it is created.
        slack:
          type: slack
          install_webhook: false
          authentication:
            webhook_url: "$(SLACK_WEBHOOK_URL)"

{% set keep_url = "https://" ~ keep.hostname %}
{% set ask = "<@" ~ keep.slack.responder ~ "> *" ~ keep.slack.keyword ~ "*: 원인과 영향 범위를 확인하고 조치 방법을 이 스레드에 남겨 주세요." %}
    # Slack messages. Keep is the only sender: Grafana, Alertmanager and Argo CD
    # send their alerts to Keep. Each workflow reads only fields its source always
    # sets, because Keep fails the action on a missing field.
    # only_on_change sends a message when the status changes, not on repeats.
    # A resolved message needs firingCounter > 1: the alert fired before.
    # Times are Slack date tokens, so each reader sees their own time zone.
    # lastReceived is the time of the status change that triggered the message.
    # Problem messages mention the kube-sre agent with its channel keyword; Agent
    # Studio runs app messages only when they contain that keyword. Resolved
    # messages carry neither, so the agent does not start on them.
    # Keep renders the mustache tags inside the Jinja2 raw blocks.
      workflows:
        - id: grafana-alert-to-slack
          name: Grafana alert to Slack
          description: Sends each Grafana alert that starts firing to Slack and asks kube-sre to investigate.
          triggers:
            - type: alert
              cel: '"grafana" in source && status == "firing"'
              only_on_change: [status]
          actions:
            - name: slack
              provider:
                type: slack
                config: "{% raw %}{{ providers.slack }}{% endraw %}"
                with:
                  message: '{% raw %}🔴 {{ alert.name }} — {{ alert.annotations.summary }}{% endraw %} {{ ask }}'
                  blocks:
                    - type: header
                      text: {type: plain_text, emoji: true, text: "{% raw %}🔴 {{ alert.name }}{% endraw %}"}
                    - type: section
                      text:
                        type: mrkdwn
                        text: |-
                          {% raw %}*{{ alert.annotations.summary }}*
                          {{ alert.description }}{% endraw %}
                    - type: context
                      elements:
                        - type: mrkdwn
                          text: "{% raw %}심각도 `{{ alert.severity }}` · Grafana · 시작 <!date^keep.to_timestamp('{{ alert.lastReceived }}')^{date_short_pretty} {time}|{{ alert.lastReceived }}>{% endraw %}"
                    - type: section
                      text:
                        type: mrkdwn
                        text: "{% raw %}<{{ alert.dashboardUrl }}|대시보드> · <{{ alert.url }}|규칙> · <{{ alert.silenceURL }}|알림 끄기>{% endraw %} · <{{ keep_url }}/alerts/feed|Keep>"
                    - type: section
                      text: {type: mrkdwn, text: "{{ ask }}"}

        - id: prometheus-alert-to-slack
          name: Prometheus alert to Slack
          description: Sends critical and Agent platform Prometheus alerts that start firing to Slack and asks kube-sre to investigate.
          triggers:
            - type: alert
              cel: '"prometheus" in source && status == "firing" && (severity == "critical" || (type(service) == string && service.matches("^agent-(studio|forge|knowledge)$")))'
              only_on_change: [status]
          actions:
            - name: slack
              provider:
                type: slack
                config: "{% raw %}{{ providers.slack }}{% endraw %}"
                with:
                  message: '{% raw %}🔴 {{ alert.name }} — {{ alert.description }}{% endraw %} {{ ask }}'
                  blocks:
                    - type: header
                      text: {type: plain_text, emoji: true, text: "{% raw %}🔴 {{ alert.name }}{% endraw %}"}
                    - type: section
                      text: {type: mrkdwn, text: "{% raw %}{{ alert.description }}{% endraw %}"}
                    - type: context
                      elements:
                        - type: mrkdwn
                          text: "{% raw %}심각도 `{{ alert.severity }}` · Prometheus · 시작 <!date^keep.to_timestamp('{{ alert.lastReceived }}')^{date_short_pretty} {time}|{{ alert.lastReceived }}>{% endraw %}"
                    - type: section
                      text: {type: mrkdwn, text: "<{{ keep_url }}/alerts/feed|Keep>"}
                    - type: section
                      text: {type: mrkdwn, text: "{{ ask }}"}

        - id: argocd-alert-to-slack
          name: Argo CD alert to Slack
          description: Sends each Argo CD application problem to Slack and asks kube-sre to investigate.
          triggers:
            - type: alert
              cel: '"argocd" in source && status == "firing"'
              only_on_change: [status]
          actions:
            - name: slack
              provider:
                type: slack
                config: "{% raw %}{{ providers.slack }}{% endraw %}"
                with:
                  message: '{% raw %}🔴 {{ alert.name }}{% endraw %} {{ ask }}'
                  blocks:
                    - type: header
                      text: {type: plain_text, emoji: true, text: "{% raw %}🔴 {{ alert.name }}{% endraw %}"}
                    - type: section
                      text: {type: mrkdwn, text: "{% raw %}{{ alert.description }}{% endraw %}"}
                    - type: context
                      elements:
                        - type: mrkdwn
                          text: "{% raw %}심각도 `{{ alert.severity }}` · Argo CD · 프로젝트 `{{ alert.labels.project }}` · 시작 <!date^keep.to_timestamp('{{ alert.lastReceived }}')^{date_short_pretty} {time}|{{ alert.lastReceived }}>{% endraw %}"
                    - type: section
                      text: {type: mrkdwn, text: "{% raw %}<{{ alert.url }}|Argo CD>{% endraw %} · <{{ keep_url }}/alerts/feed|Keep>"}
                    - type: section
                      text: {type: mrkdwn, text: "{{ ask }}"}

        - id: alert-resolved-to-slack
          name: Resolved alert to Slack
          description: Tells Slack that an alert which was sent there has resolved.
          triggers:
            - type: alert
              # The same sources and filters as the firing workflows above.
              cel: 'status == "resolved" && firingCounter > 1 && ("grafana" in source || "argocd" in source || ("prometheus" in source && (severity == "critical" || (type(service) == string && service.matches("^agent-(studio|forge|knowledge)$")))))'
              only_on_change: [status]
          actions:
            - name: slack
              provider:
                type: slack
                config: "{% raw %}{{ providers.slack }}{% endraw %}"
                with:
                  message: "{% raw %}✅ 해소: {{ alert.name }}{% endraw %}"
                  blocks:
                    - type: section
                      text: {type: mrkdwn, text: "{% raw %}✅ *해소* {{ alert.name }}{% endraw %}"}
                    - type: context
                      elements:
                        - type: mrkdwn
                          text: "{% raw %}심각도 `{{ alert.severity }}` · 해소 <!date^keep.to_timestamp('{{ alert.lastReceived }}')^{date_short_pretty} {time}|{{ alert.lastReceived }}>{% endraw %} · <{{ keep_url }}/alerts/feed|Keep>"

        - id: incident-to-slack
          name: New incident to Slack
          description: Sends each incident Keep creates to Slack and asks kube-sre to investigate.
          triggers:
            - type: incident
              events: [created]
          actions:
            - name: slack
              provider:
                type: slack
                config: "{% raw %}{{ providers.slack }}{% endraw %}"
                with:
                  message: '{% raw %}🧩 새 incident: {{ incident.name }}{% endraw %} {{ ask }}'
                  blocks:
                    - type: header
                      text: {type: plain_text, emoji: true, text: "{% raw %}🧩 새 incident: {{ incident.name }}{% endraw %}"}
                    - type: section
                      text: {type: mrkdwn, text: "{% raw %}경보 {{ incident.alerts_count }}개를 하나의 incident로 묶었습니다. 심각도 `{{ incident.severity }}`{% endraw %}"}
                    - type: section
                      text: {type: mrkdwn, text: "<{{ keep_url }}/incidents/{% raw %}{{ incident.id }}{% endraw %}|Keep에서 보기>"}
                    - type: section
                      text: {type: mrkdwn, text: "{{ ask }}"}

  frontend:
    env:
      - name: NEXTAUTH_URL
        value: "https://{{keep.hostname}}"
      - name: VERCEL
        value: "1"
      - name: ENV
        value: production
      - name: NODE_ENV
        value: production
      - name: HOSTNAME
        value: 0.0.0.0
      - name: FRIGADE_DISABLED
        value: "true"
      - name: PUSHER_DISABLED
        value: "true"
      - name: AUTH_TYPE
        value: OIDC
      - name: KEEP_OIDC_ISSUER
        value: "https://{{argocd.hostname}}/api/dex"
      - name: KEEP_OIDC_CLIENT_ID
        value: keep-sso
      - name: KEEP_OIDC_ADMIN_ROLES
        value: "{{argocd.github.org}}:{{argocd.github.team}}"

    podAnnotations:
      link.argocd.argoproj.io/external-link: "https://{{keep.hostname}}"

raw:
  resources:
    # The UI calls the API through its own /backend rewrite, so one route serves both.
    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
        name: keep
        annotations:
          link.argocd.argoproj.io/external-link: "https://{{keep.hostname}}"
      spec:
        parentRefs:
          - group: gateway.networking.k8s.io
            kind: Gateway
{% if gateway is defined %}
            name: "{{gateway.name}}"
            namespace: "{{gateway.namespace}}"
{% else %}
            name: istio-ingressgateway
            namespace: istio-system
{% endif %}
        hostnames:
          - "{{keep.hostname}}"
        rules:
          - matches:
              - path:
                  type: PathPrefix
                  value: /
            backendRefs:
              - name: keep-frontend
                port: 3000

    # Names start with addon-keep-, not keep-: the chart's pre-delete hook
    # deletes every Secret whose name starts with keep-.
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: addon-keep-database
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: addon-keep-database
        data:
          - secretKey: password
            remoteRef:
              key: /k8s/common/keep/database-password

    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: addon-keep-backend
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: addon-keep-backend
          template:
            engineVersion: v2
            data:
              DATABASE_CONNECTION_STRING: "postgresql+psycopg2://postgres:{{ '{{ .database_password }}' }}@keep-database:5432/keep"
              # name:role:secret. Keep creates each key once at startup and never
              # changes an existing one; see README.md to rotate.
              KEEP_DEFAULT_API_KEYS: "grafana:webhook:{{ '{{ .grafana_api_key }}' }},argocd:webhook:{{ '{{ .argocd_api_key }}' }},alertmanager:webhook:{{ '{{ .alertmanager_api_key }}' }}"
              ARGOCD_ACCESS_TOKEN: "{{ '{{ .argocd_access_token }}' }}"
              SLACK_WEBHOOK_URL: "{{ '{{ .slack_webhook }}' }}"
        data:
          - secretKey: database_password
            remoteRef:
              key: /k8s/common/keep/database-password
          - secretKey: grafana_api_key
            remoteRef:
              key: /k8s/common/keep/grafana-api-key
          - secretKey: argocd_api_key
            remoteRef:
              key: /k8s/common/keep/argocd-api-key
          - secretKey: alertmanager_api_key
            remoteRef:
              key: /k8s/common/keep/alertmanager-api-key
          - secretKey: argocd_access_token
            remoteRef:
              key: /k8s/common/keep/argocd-api-token
          - secretKey: slack_webhook
            remoteRef:
              key: /k8s/common/keep/slack-webhook

    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: addon-keep-frontend
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: addon-keep-frontend
        data:
          - secretKey: NEXTAUTH_SECRET
            remoteRef:
              key: /k8s/common/keep/nextauth-secret
          - secretKey: KEEP_OIDC_CLIENT_SECRET
            remoteRef:
              key: /k8s/common/keep/oidc-client-secret
{% else %}
# no cluster-specific overrides
{% endif %}
