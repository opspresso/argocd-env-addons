{% if keep is defined %}
keep:
  backend:
    env:
      - name: SECRET_MANAGER_TYPE
        value: k8s
      - name: PORT
        value: "8080"
      - name: PROMETHEUS_MULTIPROC_DIR
        value: /tmp/prometheus
      # Grafana and Argo CD send alerts to this in-cluster address. Keep also
      # prints it in the webhook instructions of the providers page.
      - name: KEEP_API_URL
        value: http://keep-backend.addon-keep.svc.cluster.local:8080
      # No websocket server: Soketi takes its app secret only as a plain value.
      # The UI refreshes by polling.
      - name: PUSHER_DISABLED
        value: "true"
      - name: POSTHOG_DISABLED
        value: "true"
      - name: AUTH_TYPE
        value: OIDC
      - name: KEEP_OIDC_ISSUER
        value: "https://{{argocd.hostname}}/api/dex"
      - name: KEEP_OIDC_CLIENT_ID
        value: keep-sso
      # sso.admin_groups get admin, sso.member_groups the read-only noc role.
      # A user in no listed group gets 403: Keep has no default role.
      - name: KEEP_OIDC_ADMIN_ROLES
        value: "{{ sso.admin_groups | join(',') }}"
      - name: KEEP_OIDC_NOC_ROLES
        value: "{{ sso.member_groups | join(',') }}"

    # KEEP_PROVIDERS. Keep reconciles these at startup and removes provisioned
    # providers that are not listed. "$(NAME)" is replaced with the env var NAME.
    # install_webhook stays false: Grafana alerting and Argo CD notifications are
    # provisioned from this repository, and Keep would rewrite them.
    provision:
      providers:
        # No prometheus provider: Alertmanager pushes alerts with send_resolved.
        # Pulled alerts get a different fingerprint and never resolve.
{% if loki is defined %}
        loki:
          type: grafana_loki
          install_webhook: false
          authentication:
            host_url: http://loki.addon-loki.svc.cluster.local:3100
            authentication_type: NoAuth
{% endif %}
        argocd:
          type: argocd
          install_webhook: false
          authentication:
            deployment_url: http://argocd-server.argocd.svc.cluster.local
            argocd_access_token: "$(ARGOCD_ACCESS_TOKEN)"
        # Bot token of the Slack app "Keep" in the nalbam workspace
        # (chat:write, chat:write.public). A token, not a webhook: the workflows
        # edit a posted message and reply in its thread.
        slack:
          type: slack
          install_webhook: false
          authentication:
            access_token: "$(SLACK_BOT_TOKEN)"

{% set keep_url = "https://" ~ keep.hostname %}
{% set channel = keep.slack.channel %}
{% set ask = "<@" ~ keep.slack.responder ~ "> *" ~ keep.slack.keyword ~ "*: 이 경보의 원인과 영향, 우선 조치를 이 스레드에 짧게 남겨 주세요." %}
{% set at %}{% raw %}<!date^keep.to_timestamp('{{ alert.lastReceived }}')^{date_short_pretty} {time}|{{ alert.lastReceived }}>{% endraw %}{% endset %}
{% set keep_link = "<" ~ keep_url ~ "/alerts/feed|Keep>" %}
{#- Blocks of one alert message. The problem message and its resolved edit share
    the body and the links, so the edited message still shows what happened. -#}
{% macro alert_blocks(state, body, meta, links) %}
                    - type: header
                      text: {type: plain_text, emoji: true, text: "{% if state == 'firing' %}🔴{% else %}✅{% endif %} {% raw %}{{ alert.name }}{% endraw %}"}
                    - type: section
                      text: {type: mrkdwn, text: "{{ body }}"}
                    - type: context
                      elements:
                        - {type: mrkdwn, text: "심각도 `{% raw %}{{ alert.severity }}{% endraw %}` · {{ meta }} · {% if state == 'firing' %}시작{% else %}해소{% endif %} {{ at }}"}
                    - type: section
                      text: {type: mrkdwn, text: "{{ links }}"}
{% if state == 'firing' %}
                    - type: section
                      text: {type: mrkdwn, text: "{{ ask }}"}
{% else %}
                    - type: context
                      elements:
                        - {type: mrkdwn, text: "✅ *해소됨* {{ at }}"}
{% endif %}
{%- endmacro %}
{#- One workflow per source. Actions by status:
    firing   → post the problem to the channel and store its ts on the alert;
    resolved → edit that message to the resolved form and reply in its thread.
    A resolved alert without a stored ts (sent before threads existed) gets a
    channel message instead. -#}
{% macro source_workflow(id, name, description, cel, text, body, meta, links) %}
        - id: {{ id }}
          name: {{ name }}
          description: {{ description }}
          triggers:
            - type: alert
              cel: '{{ cel }}'
              only_on_change: [status]
          actions:
            - name: post-problem
              if: "'{% raw %}{{ alert.status }}{% endraw %}' == 'firing'"
              provider:
                type: slack
                config: "{% raw %}{{ providers.slack }}{% endraw %}"
                with:
                  channel: {{ channel }}
                  message: "🔴 {{ text }} {{ ask }}"
                  enrich_alert:
                    - {key: slack_timestamp, value: results.slack_timestamp}
                  blocks:
{{ alert_blocks('firing', body, meta, links) }}
            - name: mark-resolved
              if: "'{% raw %}{{ alert.status }}{% endraw %}' == 'resolved' and '{% raw %}{{ alert.slack_timestamp }}{% endraw %}'"
              provider:
                type: slack
                config: "{% raw %}{{ providers.slack }}{% endraw %}"
                with:
                  channel: {{ channel }}
                  slack_timestamp: "{% raw %}{{ alert.slack_timestamp }}{% endraw %}"
                  message: "✅ {{ text }}"
                  blocks:
{{ alert_blocks('resolved', body, meta, links) }}
            - name: reply-resolved
              if: "'{% raw %}{{ alert.status }}{% endraw %}' == 'resolved' and '{% raw %}{{ alert.slack_timestamp }}{% endraw %}'"
              provider:
                type: slack
                config: "{% raw %}{{ providers.slack }}{% endraw %}"
                with:
                  channel: {{ channel }}
                  thread_timestamp: "{% raw %}{{ alert.slack_timestamp }}{% endraw %}"
                  message: "✅ 해소됐습니다. {{ at }}"
            - name: post-resolved
              if: "'{% raw %}{{ alert.status }}{% endraw %}' == 'resolved' and not '{% raw %}{{ alert.slack_timestamp }}{% endraw %}'"
              provider:
                type: slack
                config: "{% raw %}{{ providers.slack }}{% endraw %}"
                with:
                  channel: {{ channel }}
                  message: "✅ 해소: {% raw %}{{ alert.name }}{% endraw %} {{ at }}"
{%- endmacro %}
{% set agent_service = '(type(service) == string && service.matches("^agent-(studio|forge|knowledge)$"))' %}
{% set problem_or_recovery = '(status == "firing" || (status == "resolved" && firingCounter > 1))' %}
    # Slack messages. Keep is the only sender: Grafana, Alertmanager and Argo CD
    # send their alerts to Keep. The Slack app "Keep" posts with its bot token.
    # Each workflow reads only fields its source always sets, because Keep fails
    # the action on a missing field.
    # Slack gets only alerts that need a person: critical Grafana and Prometheus
    # alerts (and Agent platform alerts), and Argo CD sync failures. Warnings
    # stay in Keep. Rules wait out short states before they turn critical.
    # only_on_change sends on status changes, not on repeats. A recovery counts
    # only after a firing (firingCounter > 1).
    # Problem messages mention the kube-sre agent with its channel keyword; Agent
    # Studio runs app messages only when they contain that keyword. The resolved
    # edit and the thread reply carry neither (Studio also ignores edits and other
    # apps' thread replies).
    # Times are Slack date tokens, so each reader sees their own time zone.
    # Keep renders the mustache tags inside the Jinja2 raw blocks.
      workflows:
{% set text %}{% raw %}{{ alert.name }} — {{ alert.annotations.summary }}{% endraw %}{% endset %}
{% set body %}{% raw %}*{{ alert.annotations.summary }}*\n{{ alert.description }}{% endraw %}{% endset %}
{% set links %}{% raw %}<{{ alert.dashboardUrl }}|대시보드> · <{{ alert.url }}|규칙> · <{{ alert.silenceURL }}|알림 끄기>{% endraw %} · {{ keep_link }}{% endset %}
{{ source_workflow('grafana-alert-to-slack', 'Grafana alert to Slack',
     'Posts critical Grafana alerts to Slack, asks kube-sre to investigate, and marks the message resolved.',
     '"grafana" in source && severity == "critical" && ' ~ problem_or_recovery, text, body, 'Grafana', links) }}

{% set text %}{% raw %}{{ alert.name }} — {{ alert.description }}{% endraw %}{% endset %}
{% set body %}{% raw %}{{ alert.description }}{% endraw %}{% endset %}
{{ source_workflow('prometheus-alert-to-slack', 'Prometheus alert to Slack',
     'Posts critical and Agent platform Prometheus alerts to Slack, asks kube-sre to investigate, and marks the message resolved.',
     '"prometheus" in source && (severity == "critical" || ' ~ agent_service ~ ') && ' ~ problem_or_recovery,
     text, body, 'Prometheus', keep_link) }}

{% set text %}{% raw %}{{ alert.name }}{% endraw %}{% endset %}
{% set meta %}{% raw %}Argo CD · 프로젝트 `{{ alert.labels.project }}`{% endraw %}{% endset %}
{% set links %}{% raw %}<{{ alert.url }}|Argo CD>{% endraw %} · {{ keep_link }}{% endset %}
{{ source_workflow('argocd-alert-to-slack', 'Argo CD alert to Slack',
     'Posts each Argo CD sync failure to Slack, asks kube-sre to investigate, and marks the message resolved.',
     '"argocd" in source && ' ~ problem_or_recovery, text, body, meta, links) }}

        - id: incident-to-slack
          name: New incident to Slack
          description: Posts each incident Keep creates to Slack and asks kube-sre to investigate.
          triggers:
            - type: incident
              events: [created]
          actions:
            - name: slack
              provider:
                type: slack
                config: "{% raw %}{{ providers.slack }}{% endraw %}"
                with:
                  channel: {{ channel }}
                  message: '{% raw %}🧩 새 incident: {{ incident.name }}{% endraw %} {{ ask }}'
                  blocks:
                    - type: header
                      text: {type: plain_text, emoji: true, text: "{% raw %}🧩 새 incident: {{ incident.name }}{% endraw %}"}
                    - type: section
                      text: {type: mrkdwn, text: "{% raw %}경보 {{ incident.alerts_count }}개를 하나의 incident로 묶었습니다. 심각도 `{{ incident.severity }}`{% endraw %}"}
                    - type: section
                      text: {type: mrkdwn, text: "<{{ keep_url }}/incidents/{% raw %}{{ incident.id }}{% endraw %}|Keep에서 보기>"}
                    - type: section
                      text: {type: mrkdwn, text: "{{ ask }}"}
  frontend:
    env:
      - name: NEXTAUTH_URL
        value: "https://{{keep.hostname}}"
      - name: VERCEL
        value: "1"
      - name: ENV
        value: production
      - name: NODE_ENV
        value: production
      - name: HOSTNAME
        value: 0.0.0.0
      - name: FRIGADE_DISABLED
        value: "true"
      - name: PUSHER_DISABLED
        value: "true"
      - name: AUTH_TYPE
        value: OIDC
      - name: KEEP_OIDC_ISSUER
        value: "https://{{argocd.hostname}}/api/dex"
      - name: KEEP_OIDC_CLIENT_ID
        value: keep-sso
      - name: KEEP_OIDC_ADMIN_ROLES
        value: "{{ sso.admin_groups | join(',') }}"
      - name: KEEP_OIDC_NOC_ROLES
        value: "{{ sso.member_groups | join(',') }}"

    podAnnotations:
      link.argocd.argoproj.io/external-link: "https://{{keep.hostname}}"

raw:
  resources:
    # The UI calls the API through its own /backend rewrite, so one route serves both.
    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
        name: keep
        annotations:
          link.argocd.argoproj.io/external-link: "https://{{keep.hostname}}"
      spec:
        parentRefs:
          - group: gateway.networking.k8s.io
            kind: Gateway
{% if gateway is defined %}
            name: "{{gateway.name}}"
            namespace: "{{gateway.namespace}}"
{% else %}
            name: istio-ingressgateway
            namespace: istio-system
{% endif %}
        hostnames:
          - "{{keep.hostname}}"
        rules:
          - matches:
              - path:
                  type: PathPrefix
                  value: /
            backendRefs:
              - name: keep-frontend
                port: 3000

    # Slack fetches every link of a Keep message to build a preview. Keep,
    # Grafana and Argo CD show it only a sign-in page, so each alert gets
    # previews of sign-in pages. Keep's Slack provider cannot send
    # unfurl_links=false, so the gateway refuses Slack's link expander
    # (User-Agent "Slackbot-LinkExpanding ...") on these hosts.
    - apiVersion: security.istio.io/v1
      kind: AuthorizationPolicy
      metadata:
        name: keep-slack-no-unfurl
        namespace: istio-system
      spec:
        selector:
          matchLabels:
            istio: ingressgateway
        action: DENY
        rules:
          - to:
              - operation:
                  hosts:
                    - "{{keep.hostname}}"
                    - "{{grafana.hostname}}"
                    - "{{argocd.hostname}}"
            when:
              - key: request.headers[User-Agent]
                values: ["Slackbot*"]

    # Names start with addon-keep-, not keep-: the chart's pre-delete hook
    # deletes every Secret whose name starts with keep-.
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: addon-keep-database
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: addon-keep-database
        data:
          - secretKey: password
            remoteRef:
              key: /k8s/common/keep/database-password

    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: addon-keep-backend
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: addon-keep-backend
          template:
            engineVersion: v2
            data:
              DATABASE_CONNECTION_STRING: "postgresql+psycopg2://postgres:{{ '{{ .database_password }}' }}@keep-database:5432/keep"
              # name:role:secret. Keep creates each key once at startup and never
              # changes an existing one; see README.md to rotate.
              KEEP_DEFAULT_API_KEYS: "grafana:webhook:{{ '{{ .grafana_api_key }}' }},argocd:webhook:{{ '{{ .argocd_api_key }}' }},alertmanager:webhook:{{ '{{ .alertmanager_api_key }}' }}"
              ARGOCD_ACCESS_TOKEN: "{{ '{{ .argocd_access_token }}' }}"
              SLACK_BOT_TOKEN: "{{ '{{ .slack_bot_token }}' }}"
        data:
          - secretKey: database_password
            remoteRef:
              key: /k8s/common/keep/database-password
          - secretKey: grafana_api_key
            remoteRef:
              key: /k8s/common/keep/grafana-api-key
          - secretKey: argocd_api_key
            remoteRef:
              key: /k8s/common/keep/argocd-api-key
          - secretKey: alertmanager_api_key
            remoteRef:
              key: /k8s/common/keep/alertmanager-api-key
          - secretKey: argocd_access_token
            remoteRef:
              key: /k8s/common/keep/argocd-api-token
          - secretKey: slack_bot_token
            remoteRef:
              key: /k8s/common/keep/slack-bot-token

    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: addon-keep-frontend
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: addon-keep-frontend
        data:
          - secretKey: NEXTAUTH_SECRET
            remoteRef:
              key: /k8s/common/keep/nextauth-secret
          - secretKey: KEEP_OIDC_CLIENT_SECRET
            remoteRef:
              key: /k8s/common/keep/oidc-client-secret
{% else %}
# no cluster-specific overrides
{% endif %}
