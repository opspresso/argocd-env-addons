loki:
  fullnameOverride: loki

{% if loki is defined %}
  # The chart labels its own metrics cluster=<release>, which lands as
  # cluster="loki" and puts this one job outside every cluster filter.
  clusterLabelOverride: {{cluster}}

  monitoring:
    serviceMonitor:
      enabled: {{prometheus.serviceMonitor.enabled}}
      labels:
{% if metrics is defined and metrics.backend == 'victoria-metrics' %}
        release: victoria-metrics-{{cluster}}
{% else %}
        release: prometheus-{{cluster}}
{% endif %}

{% if monitoring is defined %}
{% if monitoring.nodeSelector is defined %}
  singleBinary:
    tolerations:
      - key: group
        operator: Equal
        value: "{{monitoring.nodeSelector}}"
        effect: NoSchedule
    nodeSelector:
      group: "{{monitoring.nodeSelector}}"
{% endif %}
{% endif %}

raw:
  resources:
    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
        name: loki
      spec:
        parentRefs:
          - name: istio-ingressgateway
            namespace: istio-system
        hostnames:
          - "{{loki.hostname}}"
        rules:
          - backendRefs:
              - name: loki
                port: 3100
{% endif %}
