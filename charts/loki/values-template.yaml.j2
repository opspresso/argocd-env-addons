{% filter trim %}
loki:
  fullnameOverride: loki

{% if resources is defined and not resources.enabled %}
  singleBinary:
    resources: null
  sidecar:
    resources: null
{% endif %}
{% if loki is defined %}
  # The chart labels its own metrics cluster=<release>, which lands as
  # cluster="loki" and puts this one job outside every cluster filter.
  clusterLabelOverride: {{cluster}}

  monitoring:
    serviceMonitor:
      enabled: {{prometheus.serviceMonitor.enabled}}
      labels:
        release: prometheus-{{cluster}}

{%- if env == 'eks' %}
raw:
  resources:
    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
        name: loki
      spec:
        parentRefs:
          - name: istio-ingressgateway
            namespace: istio-system
        hostnames:
          - "{{loki.hostname}}"
        rules:
          - backendRefs:
              - name: loki
                port: 3100
{% endif %}

{%- endif -%}

{% endfilter %}
