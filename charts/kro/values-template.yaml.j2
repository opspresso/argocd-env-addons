kro:
  fullnameOverride: kro

{% if delivery_resources is defined %}
{% set rds = delivery_resources.rds %}
{% set valkey = delivery_resources.valkey %}
# Platform templates that Agent Runway instantiates in app-<slug>-<env> namespaces
# (agent-platform docs/DELIVERY_V2.md D3, D4). A template that needs network objects from
# terraform-env-demo demo/8-app-delivery renders only once its security group is set.
raw:
  resources:
{% if rds.security_group_id %}
    # kro reconciles RdsPostgres instances and the kinds the template creates. The chart's
    # aggregated ClusterRole kro:controller picks these rules up by the label.
    - apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: kro:controller:rds-postgres
        labels:
          rbac.kro.run/aggregate-to-controller: "true"
      rules:
        - apiGroups: [kro.run]
          resources: [rdspostgres, rdspostgres/status, rdspostgres/finalizers]
          verbs: ["*"]
        - apiGroups: [rds.services.k8s.aws]
          resources: [dbinstances]
          verbs: ["*"]
        - apiGroups: [networking.k8s.io]
          resources: [networkpolicies]
          verbs: ["*"]

    # One single-AZ RDS for PostgreSQL instance per RdsPostgres, in the shared subnet group and
    # security group from terraform-env-demo demo/8-app-delivery, plus the egress NetworkPolicy
    # that lets the instance namespace reach the DB subnets.
    - apiVersion: kro.run/v1alpha1
      kind: ResourceGraphDefinition
      metadata:
        name: rds-postgres
      spec:
        schema:
          apiVersion: v1alpha1
          kind: RdsPostgres
          spec:
            dbName: string | default="app" immutable=true pattern="^[a-z][a-z0-9_]{0,62}$" description="Initial database name"
            username: string | default="app" immutable=true pattern="^[a-z][a-z0-9_]{0,15}$" description="Master user name"
            passwordSecret:
              name: string | default="app-env" pattern="^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" maxLength=253 description="Secret in the instance namespace that holds the master password"
              key: string | required=true pattern="^[A-Z][A-Z0-9_]{0,63}$" description="Key of the master password in the Secret (an Agent Runway Variable name)"
            instanceClass: string | default="db.t4g.micro" enum="db.t4g.micro,db.t4g.small" description="RDS instance class"
            storageGiB: integer | default=20 minimum=20 maximum=100 description="gp3 storage in GiB. RDS can only increase it"
          status:
            dbInstanceIdentifier: ${dbInstance.spec.dbInstanceIdentifier}
            address: ${dbInstance.status.endpoint.address}
            port: ${dbInstance.status.endpoint.port}
            dbInstanceStatus: ${dbInstance.status.?dbInstanceStatus.orValue("")}
            engineVersion: ${dbInstance.spec.?engineVersion.orValue("")}
            # ACK.Terminal: the controller stops retrying until the spec changes.
            terminal: '${dbInstance.status.?conditions.orValue([]).exists(c, c.type == "ACK.Terminal" && c.status == "True")}'
            message: '${dbInstance.status.?conditions.orValue([]).filter(c, (c.type == "ACK.Terminal" || c.type == "ACK.Recoverable") && c.status == "True").map(c, c.?message.orValue("")).join("; ")}'
        resources:
          - id: dbInstance
            readyWhen:
              - ${dbInstance.status.?dbInstanceStatus.orValue("") == "available"}
              - ${dbInstance.status.?endpoint.?address.orValue("") != ""}
            template:
              apiVersion: rds.services.k8s.aws/v1alpha1
              kind: DBInstance
              metadata:
                name: ${schema.metadata.name}
                annotations:
                  # Deleting the instance (resource removed, or its environment's Application deleted) always keeps a
                  # final snapshot. ACK skips it unless told otherwise. The name is the DB identifier plus the instance
                  # UID, so a later instance with the same name never collides with an old snapshot.
                  rds.services.k8s.aws/skip-final-snapshot: "false"
                  rds.services.k8s.aws/final-db-snapshot-identifier: '${"app-" + "%x".format([hash.sha256("{{cluster}}/" + schema.metadata.namespace + "/" + schema.metadata.name)]).substring(0, 32) + "-final-" + schema.metadata.uid}'
              spec:
                # app-<first 32 hex digits (128 bits) of SHA-256 over "<cluster>/<namespace>/<name>">: 36 characters,
                # unique per cluster, namespace and name, and inside the IAM scope db:app-*. ACK takes over an existing
                # instance of the same identifier, so a tenant must not be able to choose a name that hashes to another
                # tenant's identifier: a 64-bit FNV hash allows that, a 128-bit SHA-256 prefix does not.
                dbInstanceIdentifier: '${"app-" + "%x".format([hash.sha256("{{cluster}}/" + schema.metadata.namespace + "/" + schema.metadata.name)]).substring(0, 32)}'
                engine: postgres
                # No engineVersion: RDS uses its default major version. ACK writes the full version
                # back to the spec, and a template value would make kro and ACK overwrite each other.
                dbInstanceClass: ${schema.spec.instanceClass}
                storageType: gp3
                allocatedStorage: ${schema.spec.storageGiB}
                storageEncrypted: true
                multiAZ: false
                publiclyAccessible: false
                deletionProtection: false
                backupRetentionPeriod: 1
                port: 5432
                dbName: ${schema.spec.dbName}
                masterUsername: ${schema.spec.username}
                masterUserPassword:
                  namespace: ${schema.metadata.namespace}
                  name: ${schema.spec.passwordSecret.name}
                  key: ${schema.spec.passwordSecret.key}
                dbSubnetGroupName: "{{rds.subnet_group}}"
                # rds.force_ssl=1: connections without TLS are refused (clients use sslmode=require).
                dbParameterGroupName: "{{rds.parameter_group}}"
                vpcSecurityGroupIDs:
                  - "{{rds.security_group_id}}"

          # App namespaces deny egress to private ranges. This adds TCP 5432 to the DB subnets for
          # the instance namespace only; other namespaces stay blocked.
          - id: networkPolicy
            template:
              apiVersion: networking.k8s.io/v1
              kind: NetworkPolicy
              metadata:
                name: rds-postgres-${schema.metadata.name}
              spec:
                podSelector: {}
                policyTypes: [Egress]
                egress:
                  - to:
{% for cidr in rds.subnet_cidrs %}
                      - ipBlock:
                          cidr: "{{cidr}}"
{% endfor %}
                    ports:
                      - protocol: TCP
                        port: 5432
{% endif %}
{% if valkey.security_group_id %}
    # kro reconciles ValkeyCache instances and the ElastiCache kinds the template creates.
    - apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: kro:controller:valkey-cache
        labels:
          rbac.kro.run/aggregate-to-controller: "true"
      rules:
        - apiGroups: [kro.run]
          resources: [valkeycaches, valkeycaches/status, valkeycaches/finalizers]
          verbs: ["*"]
        - apiGroups: [elasticache.services.k8s.aws]
          resources: [serverlesscaches, users, usergroups]
          verbs: ["*"]
        - apiGroups: [networking.k8s.io]
          resources: [networkpolicies]
          verbs: ["*"]

    # One ElastiCache Serverless Valkey cache per ValkeyCache, with its own user and user group, in the intra
    # subnets and the security group from terraform-env-demo demo/8-app-delivery, plus the egress NetworkPolicy
    # that lets the instance namespace reach the cache subnets. Serverless caches accept TLS connections only.
    - apiVersion: kro.run/v1alpha1
      kind: ResourceGraphDefinition
      metadata:
        name: valkey-cache
      spec:
        schema:
          apiVersion: v1alpha1
          kind: ValkeyCache
          spec:
            username: string | default="app" immutable=true pattern="^[a-z][a-z0-9_-]{0,31}$" description="Valkey user name"
            passwordSecret:
              name: string | default="app-env" pattern="^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" maxLength=253 description="Secret in the instance namespace that holds the user password"
              key: string | required=true pattern="^[A-Z][A-Z0-9_]{0,63}$" description="Key of the user password in the Secret (an Agent Runway Variable name)"
            maxDataStorageGiB: integer | default=1 minimum=1 maximum=10 description="Upper limit of stored data in GB"
            maxECPUPerSecond: integer | default=1000 minimum=1000 maximum=15000 description="Upper limit of ElastiCache Processing Units per second"
          status:
            serverlessCacheName: ${serverlessCache.spec.serverlessCacheName}
            endpointAddress: ${serverlessCache.status.endpoint.address}
            endpointPort: ${serverlessCache.status.endpoint.port}
            username: ${user.spec.userName}
            cacheStatus: ${serverlessCache.status.?status.orValue("")}
            # ACK.Terminal on any of the three objects: the controller stops retrying until the spec changes.
            terminal: '${user.status.?conditions.orValue([]).exists(c, c.type == "ACK.Terminal" && c.status == "True") || userGroup.status.?conditions.orValue([]).exists(c, c.type == "ACK.Terminal" && c.status == "True") || serverlessCache.status.?conditions.orValue([]).exists(c, c.type == "ACK.Terminal" && c.status == "True")}'
            # The first object in creation order that reports an error. Later objects may not exist yet, so the
            # conditionals read them only when the earlier ones are clean.
            message: '${user.status.?conditions.orValue([]).filter(c, (c.type == "ACK.Terminal" || c.type == "ACK.Recoverable") && c.status == "True").map(c, c.?message.orValue("")).join("; ") != "" ? user.status.?conditions.orValue([]).filter(c, (c.type == "ACK.Terminal" || c.type == "ACK.Recoverable") && c.status == "True").map(c, c.?message.orValue("")).join("; ") : userGroup.status.?conditions.orValue([]).filter(c, (c.type == "ACK.Terminal" || c.type == "ACK.Recoverable") && c.status == "True").map(c, c.?message.orValue("")).join("; ") != "" ? userGroup.status.?conditions.orValue([]).filter(c, (c.type == "ACK.Terminal" || c.type == "ACK.Recoverable") && c.status == "True").map(c, c.?message.orValue("")).join("; ") : serverlessCache.status.?conditions.orValue([]).filter(c, (c.type == "ACK.Terminal" || c.type == "ACK.Recoverable") && c.status == "True").map(c, c.?message.orValue("")).join("; ")}'
        resources:
          # IDs are app-<first 32 hex digits of SHA-256 over "<cluster>/<namespace>/<name>">, like RdsPostgres: 36
          # characters (ElastiCache allows 40), unique per cluster, namespace and name, and inside the IAM scope app-*.
          - id: user
            readyWhen:
              - ${user.status.?status.orValue("") == "active"}
            template:
              apiVersion: elasticache.services.k8s.aws/v1alpha1
              kind: User
              metadata:
                name: ${schema.metadata.name}
              spec:
                userID: '${"app-" + "%x".format([hash.sha256("{{cluster}}/" + schema.metadata.namespace + "/" + schema.metadata.name)]).substring(0, 32)}'
                userName: ${schema.spec.username}
                engine: valkey
                # Every key, channel and command the engine allows. The user group holds only this user, so no
                # default user can connect.
                accessString: "on ~* &* +@all"
                authenticationMode:
                  type: password
                  passwords:
                    - namespace: ${schema.metadata.namespace}
                      name: ${schema.spec.passwordSecret.name}
                      key: ${schema.spec.passwordSecret.key}

          - id: userGroup
            readyWhen:
              - ${userGroup.status.?status.orValue("") == "active"}
            template:
              apiVersion: elasticache.services.k8s.aws/v1alpha1
              kind: UserGroup
              metadata:
                name: ${schema.metadata.name}
              spec:
                userGroupID: '${"app-" + "%x".format([hash.sha256("{{cluster}}/" + schema.metadata.namespace + "/" + schema.metadata.name)]).substring(0, 32)}'
                engine: valkey
                userIDs:
                  - ${user.spec.userID}

          - id: serverlessCache
            readyWhen:
              - ${serverlessCache.status.?status.orValue("") == "available"}
              - ${serverlessCache.status.?endpoint.?address.orValue("") != ""}
            template:
              apiVersion: elasticache.services.k8s.aws/v1alpha1
              kind: ServerlessCache
              metadata:
                name: ${schema.metadata.name}
              spec:
                serverlessCacheName: '${"app-" + "%x".format([hash.sha256("{{cluster}}/" + schema.metadata.namespace + "/" + schema.metadata.name)]).substring(0, 32)}'
                engine: valkey
                # No majorEngineVersion: ElastiCache uses its default major version, and ACK writes it back to the spec.
                description: '${"Agent Runway " + schema.metadata.namespace + "/" + schema.metadata.name}'
                cacheUsageLimits:
                  dataStorage:
                    maximum: ${schema.spec.maxDataStorageGiB}
                    unit: GB
                  eCPUPerSecond:
                    maximum: ${schema.spec.maxECPUPerSecond}
                userGroupID: ${userGroup.spec.userGroupID}
                subnetIDs:
{% for subnet in valkey.subnet_ids %}
                  - "{{subnet}}"
{% endfor %}
                securityGroupIDs:
                  - "{{valkey.security_group_id}}"

          # App namespaces deny egress to private ranges. This adds TCP 6379 to the cache subnets for the instance
          # namespace only; other namespaces stay blocked.
          - id: networkPolicy
            template:
              apiVersion: networking.k8s.io/v1
              kind: NetworkPolicy
              metadata:
                name: valkey-cache-${schema.metadata.name}
              spec:
                podSelector: {}
                policyTypes: [Egress]
                egress:
                  - to:
{% for cidr in valkey.subnet_cidrs %}
                      - ipBlock:
                          cidr: "{{cidr}}"
{% endfor %}
                    ports:
                      - protocol: TCP
                        port: 6379
{% endif %}

    # kro reconciles S3Bucket instances and the Bucket objects the template creates.
    - apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: kro:controller:s3-bucket
        labels:
          rbac.kro.run/aggregate-to-controller: "true"
      rules:
        - apiGroups: [kro.run]
          resources: [s3buckets, s3buckets/status, s3buckets/finalizers]
          verbs: ["*"]
        - apiGroups: [s3.services.k8s.aws]
          resources: [buckets]
          verbs: ["*"]
        - apiGroups: [networking.k8s.io]
          resources: [networkpolicies]
          verbs: ["*"]

    # One private S3 bucket per S3Bucket. Apps in the instance namespace reach it with the shared Pod Identity role
    # agent-delivery-tenant-objects (terraform-env-demo demo/8-agent-delivery), which matches the bucket tag
    # kubernetes-namespace against the Pod's session tag. ABAC must be on for S3 to evaluate bucket tags.
    - apiVersion: kro.run/v1alpha1
      kind: ResourceGraphDefinition
      metadata:
        name: s3-bucket
      spec:
        schema:
          apiVersion: v1alpha1
          kind: S3Bucket
          spec:
            versioning: boolean | default=false description="Keep every object version. Turning it off later suspends versioning; S3 keeps the existing versions"
          status:
            bucketName: ${bucket.spec.name}
            region: ${bucket.status.?ackResourceMetadata.?region.orValue("")}
            # ACK.Terminal: the controller stops retrying until the spec changes.
            terminal: '${bucket.status.?conditions.orValue([]).exists(c, c.type == "ACK.Terminal" && c.status == "True")}'
            message: '${bucket.status.?conditions.orValue([]).filter(c, (c.type == "ACK.Terminal" || c.type == "ACK.Recoverable") && c.status == "True").map(c, c.?message.orValue("")).join("; ")}'
        resources:
          - id: bucket
            readyWhen:
              - ${bucket.status.?conditions.orValue([]).exists(c, c.type == "ACK.ResourceSynced" && c.status == "True")}
            template:
              apiVersion: s3.services.k8s.aws/v1alpha1
              kind: Bucket
              metadata:
                name: ${schema.metadata.name}
              spec:
                # <cluster>-<first 32 hex digits of SHA-256 over "<cluster>/<namespace>/<name>">: 41 characters for
                # eks-demo, unique per cluster, namespace and name, and inside the IAM scope <cluster>-* of the ACK S3 role.
                # ACK adopts an existing bucket of the same name in the account, so the name must never be shared.
                name: '${"{{cluster}}-" + "%x".format([hash.sha256("{{cluster}}/" + schema.metadata.namespace + "/" + schema.metadata.name)]).substring(0, 32)}'
                abac:
                  status: Enabled
                tagging:
                  tagSet:
                    - key: eks-cluster-name
                      value: "{{cluster}}"
                    - key: kubernetes-namespace
                      value: ${schema.metadata.namespace}
                    - key: agent-delivery-resource
                      value: ${schema.metadata.name}
                publicAccessBlock:
                  blockPublicACLs: true
                  ignorePublicACLs: true
                  blockPublicPolicy: true
                  restrictPublicBuckets: true
                ownershipControls:
                  rules:
                    - objectOwnership: BucketOwnerEnforced
                encryption:
                  rules:
                    - applyServerSideEncryptionByDefault:
                        sseAlgorithm: AES256
                versioning:
                  status: '${schema.spec.versioning ? "Enabled" : "Suspended"}'

          # App namespaces deny egress to link-local addresses. The AWS SDK gets the Pod Identity credentials from the
          # EKS Pod Identity Agent at 169.254.170.23:80, so this opens only that address for the instance namespace.
          - id: networkPolicy
            template:
              apiVersion: networking.k8s.io/v1
              kind: NetworkPolicy
              metadata:
                name: s3-bucket-${schema.metadata.name}
              spec:
                podSelector: {}
                policyTypes: [Egress]
                egress:
                  - to:
                      - ipBlock:
                          cidr: 169.254.170.23/32
                    ports:
                      - protocol: TCP
                        port: 80
{% endif %}
