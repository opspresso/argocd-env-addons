external-secrets:
  fullnameOverride: external-secrets
{% if resources is defined and not resources.enabled %}
  resources: null
  webhook:
    resources: null
  certController:
    resources: null
{% endif %}

{% if env == 'local' %}
  extraEnv:
    - name: AWS_PROFILE
      value: "{{aws_local.profile}}"
    - name: AWS_CONFIG_FILE
      value: /aws/config
    - name: AWS_SHARED_CREDENTIALS_FILE
      value: /aws/credentials
    - name: AWS_SDK_LOAD_CONFIG
      value: "true"
  extraVolumes:
    - name: local-aws-config
      hostPath:
        path: "{{aws_local.config_file}}"
        type: File
    - name: local-aws-credentials
      hostPath:
        path: "{{aws_local.credentials_file}}"
        type: File
  extraVolumeMounts:
    - name: local-aws-config
      mountPath: /aws/config
      readOnly: true
    - name: local-aws-credentials
      mountPath: /aws/credentials
      readOnly: true
{% endif %}{% if operation is defined %}
{% if operation.nodeSelector is defined %}
  nodeSelector:
    group: "{{operation.nodeSelector}}"
  tolerations:
  - effect: NoSchedule
    key: group
    operator: Equal
    value: "{{operation.nodeSelector}}"
{% endif %}
{% endif %}

{% if operation is defined %}
{% if operation.nodeSelector is defined %}
  webhook:
    nodeSelector:
      group: "{{operation.nodeSelector}}"
    tolerations:
    - effect: NoSchedule
      key: group
      operator: Equal
      value: "{{operation.nodeSelector}}"
{% endif %}
{% endif %}

{% if operation is defined %}
{% if operation.nodeSelector is defined %}
  certController:
    nodeSelector:
      group: "{{operation.nodeSelector}}"
    tolerations:
    - effect: NoSchedule
      key: group
      operator: Equal
      value: "{{operation.nodeSelector}}"
{% endif %}
{% endif %}

raw:
  resources:
    - apiVersion: external-secrets.io/v1
      kind: ClusterSecretStore
      metadata:
        name: parameter-store
      spec:
        provider:
          aws:
            region: "{{aws_region}}"
            service: ParameterStore

    - apiVersion: external-secrets.io/v1
      kind: ClusterSecretStore
      metadata:
        name: secrets-manager
      spec:
        provider:
          aws:
            region: "{{aws_region}}"
            service: SecretsManager
