external-secrets:
  fullnameOverride: external-secrets
{% if resources is defined and not resources.enabled %}
  resources: null
  webhook:
    resources: null
  certController:
    resources: null
{% endif %}

{% if env == 'local' %}
  extraEnv:
    - name: AWS_PROFILE
      value: "{{aws_local.profile}}"
    - name: AWS_CONFIG_FILE
      value: /aws/config
    - name: AWS_SHARED_CREDENTIALS_FILE
      value: /aws/credentials
    - name: AWS_SDK_LOAD_CONFIG
      value: "true"
  extraVolumes:
    - name: local-aws-config
      hostPath:
        path: "{{aws_local.config_file}}"
        type: File
    - name: local-aws-credentials
      hostPath:
        path: "{{aws_local.credentials_file}}"
        type: File
  extraVolumeMounts:
    - name: local-aws-config
      mountPath: /aws/config
      readOnly: true
    - name: local-aws-credentials
      mountPath: /aws/credentials
      readOnly: true
{% endif %}

raw:
  resources:
    - apiVersion: external-secrets.io/v1
      kind: ClusterSecretStore
      metadata:
        name: parameter-store
      spec:
        conditions: &platform-namespaces
          # Platform paths hold every service's credentials. Only platform namespaces may
          # reference them; tenant workloads use their own namespaced SecretStore.
          - namespaceRegexes:
              - "^(argocd|sample|sample-node)$"
              - "^addon-[a-z0-9-]+$"
              - "^agent-(studio|models|memory|knowledge|forge|mcps|delivery|runway)$"
              - "^delivery-pool$"
              # The app-delivery workflow reads its GitHub token (argocd-env-projects charts/delivery).
              - "^app-delivery$"
              # rovr reads its GitHub App, model and database credentials (argocd-env-apps charts/rovr).
              - "^rovr$"
        provider:
          aws:
            region: "{{aws_region}}"
            service: ParameterStore

    - apiVersion: external-secrets.io/v1
      kind: ClusterSecretStore
      metadata:
        name: secrets-manager
      spec:
        conditions: *platform-namespaces
        provider:
          aws:
            region: "{{aws_region}}"
            service: SecretsManager
