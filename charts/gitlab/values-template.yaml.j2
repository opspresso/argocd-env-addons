{% if gitlab is defined %}
gitlab:
  global:
    hosts:
      domain: "{{hostname.public}}"
      gitlab:
        name: "{{gitlab.hostname}}"
    appConfig:
      # Sign-in through the platform Dex (charts/dex, client gitlab-sso). Dex accepts only the
      # sso groups, so the first sign-in creates an active user without admin
      # approval.
      # The sign-in page goes straight to Dex. The password form also stays off:
      # Admin > Settings > Sign-in restrictions (see README.md).
      omniauth:
        enabled: true
        autoSignInWithProvider: openid_connect
        allowSingleSignOn: [openid_connect]
        blockAutoCreatedUsers: false
        autoLinkUser: [openid_connect]
        providers:
          - secret: gitlab-oidc-provider
            key: provider

  gitlab:
    webservice:
      annotations:
        link.argocd.argoproj.io/external-link: "https://{{gitlab.hostname}}"
        # Puma reads the OIDC provider (Secret gitlab-oidc-provider) only at
        # start. A new issuer changes this annotation and rolls the Pods.
        opspresso.com/oidc-issuer: "https://{{dex.hostname}}"

raw:
  resources:
    - apiVersion: v1
      kind: ServiceAccount
      metadata:
        name: gitlab
      automountServiceAccountToken: false

    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
        name: gitlab
        annotations:
          link.argocd.argoproj.io/external-link: "https://{{gitlab.hostname}}"
      spec:
        parentRefs:
          - group: gateway.networking.k8s.io
            kind: Gateway
{% if gateway is defined %}
            name: "{{gateway.name}}"
            namespace: "{{gateway.namespace}}"
{% else %}
            name: istio-ingressgateway
            namespace: istio-system
{% endif %}
        hostnames:
          - "{{gitlab.hostname}}"
        rules:
          - matches:
              - path:
                  type: PathPrefix
                  value: /
            backendRefs:
              # Workhorse port of the webservice Service.
              - name: gitlab-webservice-default
                port: 8181

    # Fog and the AWS SDK read the role from EKS Pod Identity: no keys here.
    - apiVersion: v1
      kind: Secret
      metadata:
        name: gitlab-object-storage
      stringData:
        connection: |
          provider: AWS
          region: {{aws_region}}
          use_iam_profile: true

    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: gitlab-secret
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: gitlab-secret
        data:
          - secretKey: root-password
            remoteRef:
              key: /k8s/common/gitlab/root-password
          - secretKey: postgres-password
            remoteRef:
              key: /k8s/common/gitlab/postgres-password
          - secretKey: valkey-password
            remoteRef:
              key: /k8s/common/gitlab/valkey-password

    # The client secret is shared with the platform Dex (charts/dex).
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: gitlab-oidc-provider
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: gitlab-oidc-provider
          template:
            engineVersion: v2
            data:
              provider: |
                name: openid_connect
                label: SSO
                args:
                  name: openid_connect
                  scope: [openid, profile, email]
                  response_type: code
                  issuer: https://{{dex.hostname}}
                  discovery: true
                  pkce: true
                  client_options:
                    identifier: gitlab-sso
                    secret: {{ '"{{ .client_secret }}"' }}
                    redirect_uri: https://{{gitlab.hostname}}/users/auth/openid_connect/callback
        data:
          - secretKey: client_secret
            remoteRef:
              key: /k8s/common/gitlab/oidc-client-secret
{%- if gitlab.oauth_applications is defined %}
    # Client secrets of gitlab.oauth_applications, one key per client_id. The consumer reads the same parameter.
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: gitlab-oauth-applications
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: gitlab-oauth-applications
        data:
{%- for application in gitlab.oauth_applications %}
          - secretKey: {{ application.client_id }}
            remoteRef:
              key: {{ application.secret_key }}
{%- endfor %}
{%- endif %}
    # GitLab CE cannot map OIDC groups to administrators (Premium only). This
    # CronJob makes the users in gitlab.admins (the LLDAP logins of the
    # sso.admin_groups members) administrators and the other SSO users not.
    # It also keeps sign-up and the web password form off. root is not changed.
    # It registers gitlab.oauth_applications too: GitLab keeps OAuth applications in its database.
    - apiVersion: v1
      kind: ServiceAccount
      metadata:
        name: gitlab-admin-sync

    # Runs gitlab-rails in the toolbox Pod, which has the full Rails configuration.
    - apiVersion: rbac.authorization.k8s.io/v1
      kind: Role
      metadata:
        name: gitlab-admin-sync
      rules:
        - apiGroups: [""]
          resources: [pods]
          verbs: [get, list]
        - apiGroups: [""]
          resources: [pods/exec]
          verbs: [create]

    - apiVersion: rbac.authorization.k8s.io/v1
      kind: RoleBinding
      metadata:
        name: gitlab-admin-sync
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: Role
        name: gitlab-admin-sync
      subjects:
        - kind: ServiceAccount
          name: gitlab-admin-sync

    - apiVersion: v1
      kind: ConfigMap
      metadata:
        name: gitlab-admin-sync
      data:
        sync.sh: |
          set -eu
          # An empty list would remove every administrator: stop instead.
          [ -n "${ADMINS}" ] || { echo "gitlab.admins is empty"; exit 1; }
          pod=$(kubectl get pod -l app=toolbox --field-selector=status.phase=Running -o name | head -1)
          [ -n "${pod}" ] || { echo "no running toolbox Pod"; exit 1; }
          # Client secrets go on stdin: the API server audit log records the command line.
          secrets=$(for file in /oauth/*; do
            if [ -f "${file}" ]; then jq -Rs --arg id "$(basename "${file}")" '{($id): .}' "${file}"; fi
          done | jq -s 'add // {}')
          printf '%s' "${secrets}" | kubectl exec -i "${pod}" -c toolbox -- \
            env ADMINS="${ADMINS}" APPLICATIONS="${APPLICATIONS}" gitlab-rails runner "$(cat /scripts/sync.rb)"
        sync.rb: |
          admins = ENV.fetch("ADMINS").split(",").map(&:downcase)
          User.joins(:identities).where(identities: { provider: "openid_connect" }).find_each do |user|
            admin = admins.include?(user.username.downcase)
            next if user.admin? == admin
            user.update!(admin: admin)
            puts "#{user.username} admin=#{admin}"
          end
          settings = ApplicationSetting.current
          unless !settings.signup_enabled && !settings.password_authentication_enabled_for_web
            settings.update!(signup_enabled: false, password_authentication_enabled_for_web: false)
            puts "sign-up and web password sign-in turned off"
          end
          secrets = JSON.parse($stdin.read)
          JSON.parse(ENV.fetch("APPLICATIONS")).each do |declared|
            secret = secrets.fetch(declared.fetch("client_id"))
            application = Doorkeeper.config.application_model.find_or_initialize_by(uid: declared.fetch("client_id"))
            application.assign_attributes(name: declared.fetch("name"), redirect_uri: declared.fetch("redirect_uri"),
              scopes: declared.fetch("scopes").join(" "), confidential: true)
            application.organization ||= Organizations::Organization.default_organization
            unless application.secret_matches?(secret)
              Doorkeeper.config.application_secret_strategy.store_secret(application, :secret, secret)
            end
            next unless application.changed?
            application.save!
            puts "oauth application #{application.uid} saved"
          end

    - apiVersion: batch/v1
      kind: CronJob
      metadata:
        name: gitlab-admin-sync
      spec:
        schedule: "*/10 * * * *"
        concurrencyPolicy: Forbid
        successfulJobsHistoryLimit: 1
        failedJobsHistoryLimit: 3
        jobTemplate:
          spec:
            backoffLimit: 1
            activeDeadlineSeconds: 600
            template:
              spec:
                serviceAccountName: gitlab-admin-sync
                restartPolicy: Never
                containers:
                  - name: sync
                    image: alpine/k8s:1.37.1
                    command: [sh, /scripts/sync.sh]
                    env:
                      - name: ADMINS
                        value: "{{ gitlab.admins | default([]) | join(',') }}"
{%- set applications = [] %}
{%- for application in gitlab.oauth_applications | default([]) %}
{%- set _ = applications.append({"client_id": application.client_id, "name": application.name, "redirect_uri": application.redirect_uri, "scopes": application.scopes}) %}
{%- endfor %}
                      - name: APPLICATIONS
                        value: '{{ applications | tojson }}'
                    resources:
                      requests:
                        cpu: 10m
                        memory: 64Mi
                      limits:
                        memory: 256Mi
                    volumeMounts:
                      - name: scripts
                        mountPath: /scripts
{%- if gitlab.oauth_applications is defined %}
                      - name: oauth
                        mountPath: /oauth
                        readOnly: true
{%- endif %}
                volumes:
                  - name: scripts
                    configMap:
                      name: gitlab-admin-sync
{%- if gitlab.oauth_applications is defined %}
                  - name: oauth
                    secret:
                      secretName: gitlab-oauth-applications
{%- endif %}
{% else %}
# no cluster-specific overrides
{% endif %}
