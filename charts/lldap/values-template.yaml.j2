{% if lldap is defined %}
lldap:
  podAnnotations:
    link.argocd.argoproj.io/external-link: "https://{{lldap.hostname}}"
{%- if core_tier | default(false) %}
    # Delays voluntary disruption only: drift (03:00-05:00 KST window) and expiry still drain it after at most the NodeClaim terminationGracePeriod, restarting it once.
    karpenter.sh/do-not-disrupt: "true"
{%- endif %}
{%- if core_tier | default(false) %}
  # core_tier: the only LLDAP replica holds every account, so it runs only on the on-demand core nodes
  # (terraform-env-demo 51-core-node-pool.tf); its EBS volume picks the AZ.
  tolerations:
    - key: opspresso.com/tier
      operator: Equal
      value: core
      effect: NoSchedule
  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
          - matchExpressions:
              - key: opspresso.com/tier
                operator: In
                values: [core]
{%- endif %}

  env:
    - name: LLDAP_HTTP_URL
      value: "https://{{lldap.hostname}}"
    # Changing the base DN after the first start breaks every bind DN.
    - name: LLDAP_LDAP_BASE_DN
      value: "{{lldap.base_dn}}"
    - name: LLDAP_LDAP_USER_EMAIL
      value: "{{lldap.admin_email}}"
    # SSM is the source of the admin password: every start resets it.
    - name: LLDAP_FORCE_LDAP_USER_PASS_RESET
      value: "always"

  # The admin of Argo CD (/k8s/common/admin-user, admin-password) is the LLDAP
  # admin and the Dex bind user. install/eks/secrets.sh creates the lldap keys.
  # key-seed derives the key that stores every password: never change it.
  externalSecrets:
    enabled: true
    name: lldap-secret
    data:
      - key: /k8s/common/admin-user
        name: LLDAP_LDAP_USER_DN
      - key: /k8s/common/admin-password
        name: LLDAP_LDAP_USER_PASS
      - key: /k8s/common/lldap/jwt-secret
        name: LLDAP_JWT_SECRET
      - key: /k8s/common/lldap/key-seed
        name: LLDAP_KEY_SEED

  routing:
    hosts:
      - "{{lldap.hostname}}"
    httpRoute:
      enabled: true
      annotations:
        link.argocd.argoproj.io/external-link: "https://{{lldap.hostname}}"
      parentRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: istio-ingressgateway
          namespace: istio-system

raw:
  resources:
    # The web UI and its GraphQL API require an administrator sign-in through
    # oauth2-proxy (sso.admin_groups). LLDAP lets every user change their own
    # mail, and the email claim of the platform Dex comes from mail: Agent
    # Studio links accounts by that email (OIDC_TRUST_EMAIL), so only
    # administrators may change it.
    - apiVersion: security.istio.io/v1
      kind: AuthorizationPolicy
      metadata:
        name: lldap
        namespace: istio-system
      spec:
        selector:
          matchLabels:
            istio: ingressgateway
        action: CUSTOM
        provider:
          name: oauth2-proxy
        rules:
          - to:
              - operation:
                  hosts:
                    - "{{lldap.hostname}}"

    # After every sync: declares the groups of the sign-in rule (sso in
    # env/<cluster>.yaml) and puts the admin in the admin group. People and the
    # other memberships are managed in the LLDAP web UI. Nothing is deleted.
    - apiVersion: v1
      kind: ConfigMap
      metadata:
        name: lldap-bootstrap
      data:
        bootstrap.sh: |
          set -eu
          mkdir -p /tmp/bootstrap/group-configs /tmp/bootstrap/user-configs
          for group in ${SSO_GROUPS}; do
            jo name="${group}" > "/tmp/bootstrap/group-configs/${group}.json"
          done
          jo id="${LLDAP_ADMIN_USERNAME}" email="${ADMIN_EMAIL}" displayName=Administrator \
            groups="$(jo -a lldap_admin ${ADMIN_GROUPS})" > /tmp/bootstrap/user-configs/admin.json
          GROUP_CONFIGS_DIR=/tmp/bootstrap/group-configs \
            USER_CONFIGS_DIR=/tmp/bootstrap/user-configs \
            /app/bootstrap.sh 2>&1 | tee /tmp/bootstrap/log
          # bootstrap.sh prints GraphQL errors and still exits 0.
          if grep -Eiq 'error|failed|not exists' /tmp/bootstrap/log; then
            exit 1
          fi

    - apiVersion: batch/v1
      kind: Job
      metadata:
        name: lldap-bootstrap
        annotations:
          argocd.argoproj.io/hook: PostSync
          argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
      spec:
        backoffLimit: 3
        activeDeadlineSeconds: 300
        template:
          spec:
            restartPolicy: Never
            automountServiceAccountToken: false
            containers:
              - name: bootstrap
                image: lldap/lldap:v0.6.3-alpine-rootless
                command: [/bin/bash, /scripts/bootstrap.sh]
                env:
                  - name: LLDAP_URL
                    value: http://lldap:17170
                  - name: LLDAP_ADMIN_USERNAME
                    valueFrom:
                      secretKeyRef:
                        name: lldap-secret
                        key: LLDAP_LDAP_USER_DN
                  - name: LLDAP_ADMIN_PASSWORD
                    valueFrom:
                      secretKeyRef:
                        name: lldap-secret
                        key: LLDAP_LDAP_USER_PASS
                  - name: ADMIN_EMAIL
                    value: "{{lldap.admin_email}}"
                  - name: SSO_GROUPS
                    value: "{{ (lldap.admin_groups + lldap.member_groups) | join(' ') }}"
                  - name: ADMIN_GROUPS
                    value: "{{ lldap.admin_groups | join(' ') }}"
                resources:
                  requests:
                    cpu: 10m
                    memory: 32Mi
                  limits:
                    memory: 128Mi
                volumeMounts:
                  - name: scripts
                    mountPath: /scripts
            volumes:
              - name: scripts
                configMap:
                  name: lldap-bootstrap
{% else %}
# no cluster-specific overrides
{% endif %}
