{% if jenkins is defined %}
jenkins:
  controller:
    jenkinsUrl: "https://{{jenkins.hostname}}/"
    podAnnotations:
      link.argocd.argoproj.io/external-link: "https://{{jenkins.hostname}}"

    JCasC:
      # Sign-in through Argo CD Dex (client jenkins-sso). There is no local user
      # and no password form. sso.admin_groups administer; other users read.
      securityRealm: |-
        oic:
          serverConfiguration:
            wellKnown:
              wellKnownOpenIDConfigurationUrl: "https://{{argocd.hostname}}/api/dex/.well-known/openid-configuration"
              scopesOverride: "openid profile email groups"
          clientId: jenkins-sso
          clientSecret: "${jenkins-oidc-client-secret}"
          userNameField: preferred_username
          fullNameFieldName: name
          emailFieldName: email
          groupsFieldName: groups
      authorizationStrategy: |-
        globalMatrix:
          entries:
{% for group in sso.admin_groups %}
            - group:
                name: "{{group}}"
                permissions:
                  - "Overall/Administer"
{% endfor %}
            - group:
                name: "authenticated"
                permissions:
                  - "Overall/Read"
                  - "Job/Read"
                  - "View/Read"

raw:
  resources:
    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
        name: jenkins
        annotations:
          link.argocd.argoproj.io/external-link: "https://{{jenkins.hostname}}"
      spec:
        parentRefs:
          - group: gateway.networking.k8s.io
            kind: Gateway
{% if gateway is defined %}
            name: "{{gateway.name}}"
            namespace: "{{gateway.namespace}}"
{% else %}
            name: istio-ingressgateway
            namespace: istio-system
{% endif %}
        hostnames:
          - "{{jenkins.hostname}}"
        rules:
          - backendRefs:
              - name: jenkins
                port: 8080

    # The client secret is shared with Argo CD Dex (charts/argo-cd).
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: jenkins-oidc
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: jenkins-oidc
        data:
          - secretKey: client-secret
            remoteRef:
              key: /k8s/common/jenkins/oidc-client-secret
{% else %}
# no cluster-specific overrides
{% endif %}
