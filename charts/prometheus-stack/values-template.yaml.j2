kube-prometheus-stack:
  fullnameOverride: prometheus

  additionalPrometheusRulesMap:
    agent-platform-workloads:
      groups:
{{ workspace_alert_groups | to_yaml | indent(8, first=true) }}

  prometheus:
    route:
      main:
        enabled: {{ env == 'eks' }}
        parentRefs:
          - group: gateway.networking.k8s.io
            kind: Gateway
            name: istio-ingressgateway
            namespace: istio-system
        hostnames:
          - "prom.{{hostname.internal}}"
    prometheusSpec:
{% if resources is defined and not resources.enabled %}
      resources:
        requests: null
        limits: null
{% endif %}
{% if env == 'k3s' %}
      retention: {{prometheus.retention}}
      retentionSize: {{prometheus.retention_size}}
      enableRemoteWriteReceiver: true
      scrapeInterval: 30s
      evaluationInterval: 30s
      storageSpec:
        volumeClaimTemplate:
          spec:
            storageClassName: local-path
            accessModes: [ReadWriteOnce]
            resources:
              requests:
                storage: {{prometheus.storage_size}}
{% endif %}
      # Nothing scraped here carries a cluster label, so every dashboard's
      # cluster dropdown is empty and its cluster=~"^$cluster$" filters match
      # only because an empty regex matches a missing label. The default scrape
      # class stamps it on every target instead.
      scrapeClasses:
        - name: cluster
          default: true
          relabelings:
            # action is spelled out because the CRD defaults it, and Argo CD
            # reads the defaulted field back as drift.
            - action: replace
              targetLabel: cluster
              replacement: "{{cluster}}"

      # Series keep the label above locally; this is what alertmanager and any
      # remote write see, so an alert says which cluster it came from.
      externalLabels:
        cluster: "{{cluster}}"

{% if resources is defined and not resources.enabled %}
  prometheusOperator:
    resources: null
    admissionWebhooks:
      deployment:
        resources: null
      patch:
        resources: null
    prometheusConfigReloader:
      resources:
        requests: null
        limits: null
  alertmanager:
    alertmanagerSpec:
      resources: null
  kube-state-metrics:
    resources: null
  prometheus-node-exporter:
    resources: null
{% endif %}
{% if env == 'k3s' %}
  # k3s exposes CoreDNS on its bundled service; it has no Helm release label.
  coreDns:
    service:
      selector:
        k8s-app: kube-dns
{% endif %}

{% if monitoring is defined %}
{% if monitoring.nodeSelector is defined %}
      tolerations:
        - key: group
          operator: Equal
          value: "{{monitoring.nodeSelector}}"
          effect: NoSchedule
      nodeSelector:
        group: "{{monitoring.nodeSelector}}"

  prometheusOperator:
    tolerations:
      - key: group
        operator: Equal
        value: "{{monitoring.nodeSelector}}"
        effect: NoSchedule
    nodeSelector:
      group: "{{monitoring.nodeSelector}}"

  alertmanager:
    alertmanagerSpec:
      tolerations:
        - key: group
          operator: Equal
          value: "{{monitoring.nodeSelector}}"
          effect: NoSchedule
      nodeSelector:
        group: "{{monitoring.nodeSelector}}"

  kube-state-metrics:
    tolerations:
      - key: group
        operator: Equal
        value: "{{monitoring.nodeSelector}}"
        effect: NoSchedule
    nodeSelector:
      group: "{{monitoring.nodeSelector}}"
{% endif %}
{% endif %}

{% if env == 'eks' %}
raw:
  resources:
    # alertmanagerSpec.secrets mounts this at
    # /etc/alertmanager/secrets/prometheus-alertmanager-secret, where the slack
    # receiver reads the webhook through api_url_file.
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: prometheus-alertmanager-secret
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: prometheus-alertmanager-secret
        data:
          - secretKey: slack-hooks
            remoteRef:
              key: /k8s/common/slack-webhook/alertmanager

{%- endif %}
