kube-prometheus-stack:
  fullnameOverride: prometheus

  prometheus:
    prometheusSpec:
      # Nothing scraped here carries a cluster label, so every dashboard's
      # cluster dropdown is empty and its cluster=~"^$cluster$" filters match
      # only because an empty regex matches a missing label. The default scrape
      # class stamps it on every target instead.
      scrapeClasses:
        - name: cluster
          default: true
          relabelings:
            # action is spelled out because the CRD defaults it, and Argo CD
            # reads the defaulted field back as drift.
            - action: replace
              targetLabel: cluster
              replacement: "{{cluster}}"

      # Series keep the label above locally; this is what alertmanager and any
      # remote write see, so an alert says which cluster it came from.
      externalLabels:
        cluster: "{{cluster}}"

{% if monitoring is defined %}
{% if monitoring.nodeSelector is defined %}
      tolerations:
        - key: group
          operator: Equal
          value: "{{monitoring.nodeSelector}}"
          effect: NoSchedule
      nodeSelector:
        group: "{{monitoring.nodeSelector}}"

  prometheusOperator:
    tolerations:
      - key: group
        operator: Equal
        value: "{{monitoring.nodeSelector}}"
        effect: NoSchedule
    nodeSelector:
      group: "{{monitoring.nodeSelector}}"

  alertmanager:
    alertmanagerSpec:
      tolerations:
        - key: group
          operator: Equal
          value: "{{monitoring.nodeSelector}}"
          effect: NoSchedule
      nodeSelector:
        group: "{{monitoring.nodeSelector}}"

  kube-state-metrics:
    tolerations:
      - key: group
        operator: Equal
        value: "{{monitoring.nodeSelector}}"
        effect: NoSchedule
    nodeSelector:
      group: "{{monitoring.nodeSelector}}"
{% endif %}
{% endif %}

raw:
  resources:
    # alertmanagerSpec.secrets mounts this at
    # /etc/alertmanager/secrets/prometheus-alertmanager-secret, where the slack
    # receiver reads the webhook through api_url_file.
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: prometheus-alertmanager-secret
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: prometheus-alertmanager-secret
        data:
          - secretKey: slack-hooks
            remoteRef:
              key: /k8s/common/slack-webhook/sample-agent

    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
        name: prometheus
      spec:
        parentRefs:
          - group: gateway.networking.k8s.io
            kind: Gateway
            name: istio-ingressgateway
            namespace: istio-system
        hostnames:
          - "prom.{{hostname.internal}}"
        rules:
          - matches:
              - path:
                  type: PathPrefix
                  value: /
            backendRefs:
              - group: ""
                kind: Service
                name: prometheus-prometheus
                port: 9090
                weight: 1
