{% filter trim %}
kube-prometheus-stack:
  fullnameOverride: prometheus

  additionalPrometheusRulesMap:
    agent-platform-workloads:
      groups:
{{ workspace_alert_groups | to_yaml | indent(8, first=true) }}

{% if keep is defined and env == 'eks' %}
  # Keep runs in this cluster: Alertmanager forwards every Prometheus alert to it.
  alertmanager:
    enabled: true
  defaultRules:
    disabled:
      PrometheusNotConnectedToAlertmanagers: false

{% endif %}
  prometheus:
    route:
      main:
        enabled: {{ env == 'eks' }}
        parentRefs:
          - group: gateway.networking.k8s.io
            kind: Gateway
            name: istio-ingressgateway
            namespace: istio-system
        hostnames:
          - "prom.{{hostname.internal}}"
    prometheusSpec:
{% if resources is defined and not resources.enabled %}
      resources: null
{% endif %}
      # Nothing scraped here carries a cluster label, so every dashboard's
      # cluster dropdown is empty and its cluster=~"^$cluster$" filters match
      # only because an empty regex matches a missing label. The default scrape
      # class stamps it on every target instead.
      scrapeClasses:
        - name: cluster
          default: true
          relabelings:
            # action is spelled out because the CRD defaults it, and Argo CD
            # reads the defaulted field back as drift.
            - action: replace
              targetLabel: cluster
              replacement: "{{cluster}}"

      # Series keep the label above locally; this is what alertmanager and any
      # remote write see, so an alert says which cluster it came from.
      externalLabels:
        cluster: "{{cluster}}"

{% if resources is defined and not resources.enabled %}
  prometheusOperator:
    resources: null
    admissionWebhooks:
      deployment:
        resources: null
      patch:
        resources: null
    prometheusConfigReloader:
      resources:
        requests: null
        limits: null
  alertmanager:
    alertmanagerSpec:
      resources: null
  kube-state-metrics:
    resources: null
  prometheus-node-exporter:
    resources: null
{% endif %}

{%- if env == 'eks' %}
raw:
  resources:
    # alertmanagerSpec.secrets mounts this at
    # /etc/alertmanager/secrets/prometheus-alertmanager-secret, where the keep
    # receiver reads its API key through password_file.
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: prometheus-alertmanager-secret
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: prometheus-alertmanager-secret
        data:
          - secretKey: keep-api-key
            remoteRef:
              key: /k8s/common/keep/alertmanager-api-key

{%- endif -%}

{% endfilter %}
