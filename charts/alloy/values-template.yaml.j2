alloy:
  fullnameOverride: alloy

{% if loki is defined %}
  alloy:
    configMap:
      content: |
        discovery.kubernetes "pods" {
          role = "pod"

          // Node-local discovery only: every daemon watches its own node
          // instead of the whole cluster.
          selectors {
            role  = "pod"
            field = "spec.nodeName=" + sys.env("NODE_NAME")
          }
        }

        discovery.relabel "pods" {
          targets = discovery.kubernetes.pods.targets

          rule {
            source_labels = ["__meta_kubernetes_namespace"]
            target_label  = "namespace"
          }

          rule {
            source_labels = ["__meta_kubernetes_pod_name"]
            target_label  = "pod"
          }

          rule {
            source_labels = ["__meta_kubernetes_pod_container_name"]
            target_label  = "container"
          }

          rule {
            source_labels = ["__meta_kubernetes_pod_label_app"]
            target_label  = "app"
          }

          rule {
            source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
            regex         = "(.+)"
            target_label  = "app"
          }

          rule {
            source_labels = ["namespace", "app"]
            separator     = "/"
            target_label  = "job"
          }

          rule {
            source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
            separator     = "/"
            replacement   = "/var/log/pods/*$1/*.log"
            target_label  = "__path__"
          }
        }

        local.file_match "pods" {
          path_targets = discovery.relabel.pods.output
        }

        loki.source.file "pods" {
          targets    = local.file_match.pods.targets
          forward_to = [loki.process.pods.receiver]
        }

        loki.process "pods" {
          stage.cri {}

          // One label value per log file otherwise.
          stage.label_drop {
            values = ["filename"]
          }

          forward_to = [loki.write.default.receiver]
        }

        loki.write "default" {
          endpoint {
            url = "http://{{loki.hostname}}/loki/api/v1/push"
          }

          external_labels = {
            cluster = "{{cluster}}",
          }
        }
{% endif %}

{% if grafana_cloud is defined %}
  alloy:
    configMap:
      content: |
        prometheus.remote_write "grafana_cloud" {
          external_labels = {
            cluster = "{{cluster}}",
          }

          endpoint {
{% if metrics is defined and metrics.backend == 'victoria-metrics' %}
            url = "http://vmsingle-victoria-metrics.addon-victoria-metrics.svc.cluster.local:8428/api/v1/write"
{% else %}
            url = "{{grafana_cloud.remote_write_url}}"

            basic_auth {
              username = "{{grafana_cloud.remote_write_username}}"
              password = sys.env("GCLOUD_RW_API_KEY")
            }
{% endif %}
          }
        }

        prometheus.scrape "agent_studio" {
          targets = [{
            "__address__" = "agent-studio.agent-studio.svc.cluster.local:80",
            "instance"    = "k3s-demo",
          }]

          metrics_path    = "/api/metrics"
          scrape_interval = "15s"
          scrape_timeout  = "5s"
          job_name        = "agent-studio"
          forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
        }

        prometheus.scrape "agent_memory" {
          targets = [{
            "__address__" = "agent-memory.agent-memory.svc.cluster.local:80",
            "instance"    = "k3s-demo",
          }]

          metrics_path    = "/api/metrics"
          scrape_interval = "15s"
          scrape_timeout  = "5s"
          job_name        = "agent-memory"
          bearer_token     = sys.env("AGENT_MEMORY_METRICS_BEARER_TOKEN")
          forward_to       = [prometheus.remote_write.grafana_cloud.receiver]
        }

        // Collect host-level CPU, memory, filesystem, network and disk metrics
        // from the node where this DaemonSet instance is running.
        prometheus.exporter.unix "node" {
          procfs_path = "/host/proc"
          sysfs_path  = "/host/sys"
          rootfs_path = "/host/root"
        }

        prometheus.scrape "node" {
          targets    = prometheus.exporter.unix.node.targets
          job_name   = "node"
          forward_to = [prometheus.remote_write.grafana_cloud.receiver]
        }

        // Kubelet exposes both kubelet metrics and cAdvisor container metrics.
        discovery.kubernetes "nodes" {
          role = "node"

          // Each DaemonSet instance reports only its own node. This prevents
          // duplicate kubelet and cAdvisor series on multi-node clusters.
          selectors {
            role  = "node"
            field = "metadata.name=" + sys.env("NODE_NAME")
          }
        }

        discovery.relabel "kubelet" {
          targets = discovery.kubernetes.nodes.targets

          rule {
            source_labels = ["__meta_kubernetes_node_address_InternalIP"]
            regex         = "(.+)"
            replacement   = "$1:10250"
            target_label  = "__address__"
          }

          rule {
            target_label = "cluster"
            replacement  = "{{cluster}}"
          }
        }

        prometheus.scrape "kubelet" {
          targets           = discovery.relabel.kubelet.output
          scheme            = "https"
          metrics_path      = "/metrics"
          bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
          tls_config {
            ca_file              = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
            insecure_skip_verify = true
          }
          scrape_interval = "30s"
          scrape_timeout  = "10s"
          job_name        = "kubelet"
          forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
        }

    extraEnv:
      - name: NODE_NAME
        valueFrom:
          fieldRef:
            fieldPath: spec.nodeName
    envFrom:
      - secretRef:
          name: alloy-grafana-cloud
    mounts:
      varlog: true
      extra:
        - name: alloy-data
          mountPath: /var/lib/alloy
        - name: host-proc
          mountPath: /host/proc
          readOnly: true
        - name: host-sys
          mountPath: /host/sys
          readOnly: true
        - name: host-root
          mountPath: /host/root
          readOnly: true
{% if resources is defined and not resources.enabled %}
    resources: null
{% endif %}

  controller:
    type: daemonset

    volumes:
      extra:
        - name: alloy-data
          hostPath:
            path: /var/lib/alloy
            type: DirectoryOrCreate
        - name: host-proc
          hostPath:
            path: /proc
        - name: host-sys
          hostPath:
            path: /sys
        - name: host-root
          hostPath:
            path: /

  extraObjects:
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: alloy-grafana-cloud
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: alloy-grafana-cloud
          creationPolicy: Owner
        data:
          - secretKey: GCLOUD_RW_API_KEY
            remoteRef:
              key: /k8s/common/grafana-cloud/remote-write-api-key
          - secretKey: AGENT_MEMORY_METRICS_BEARER_TOKEN
            remoteRef:
              key: /k8s/{{cluster}}/agent-memory/metrics-bearer-token
{% endif %}
