alloy:
  fullnameOverride: alloy

{% if loki is defined %}
  alloy:
    configMap:
      content: |
        discovery.kubernetes "pods" {
          role = "pod"

          // Node-local discovery only: every daemon watches its own node
          // instead of the whole cluster.
          selectors {
            role  = "pod"
            field = "spec.nodeName=" + sys.env("NODE_NAME")
          }
        }

        discovery.relabel "pods" {
          targets = discovery.kubernetes.pods.targets

          rule {
            source_labels = ["__meta_kubernetes_namespace"]
            target_label  = "namespace"
          }

          rule {
            source_labels = ["__meta_kubernetes_pod_name"]
            target_label  = "pod"
          }

          rule {
            source_labels = ["__meta_kubernetes_pod_container_name"]
            target_label  = "container"
          }

          rule {
            source_labels = ["__meta_kubernetes_pod_label_app"]
            target_label  = "app"
          }

          rule {
            source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
            regex         = "(.+)"
            target_label  = "app"
          }

          rule {
            source_labels = ["namespace", "app"]
            separator     = "/"
            target_label  = "job"
          }

          rule {
            source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
            separator     = "/"
            replacement   = "/var/log/pods/*$1/*.log"
            target_label  = "__path__"
          }
        }

        local.file_match "pods" {
          path_targets = discovery.relabel.pods.output
        }

        loki.source.file "pods" {
          targets    = local.file_match.pods.targets
          forward_to = [loki.process.pods.receiver]
        }

        loki.process "pods" {
          stage.cri {}

          // One label value per log file otherwise.
          stage.label_drop {
            values = ["filename"]
          }

          forward_to = [loki.write.default.receiver]
        }

        loki.write "default" {
          endpoint {
            url = "http://{{loki.hostname}}/loki/api/v1/push"
          }

          external_labels = {
            cluster = "{{cluster}}",
          }
        }

  rbac:
    # The chart concatenates both lists; an empty list breaks its ClusterRole YAML.
    rules:
      - apiGroups: [""]
        resources: ["pods"]
        verbs: ["get"]
    clusterRules:
      - apiGroups: [""]
        resources: ["pods"]
        verbs: ["list", "watch"]
{% endif %}

{% if grafana_cloud is defined %}
  alloy:
    configMap:
      content: |
        prometheus.remote_write "grafana_cloud" {
          external_labels = { "cluster" = "{{cluster}}" }

          endpoint {
            url = "{{grafana_cloud.remote_write_url}}"
            basic_auth {
              username = "{{grafana_cloud.remote_write_username}}"
              password = sys.env("GCLOUD_RW_API_KEY")
            }

            // Bound Cloud series usage while retaining the dashboard metrics.
            write_relabel_config {
              source_labels = ["job", "__name__"]
              regex = "integrations/node_exporter;.+|agent-studio;.+|agent-memory;.+|kubelet;(up|kubelet_(node_name|running_pods|running_containers|volume_stats_.+|runtime_operations_(total|errors_total)))|integrations/cadvisor;(up|container_(cpu_usage_seconds_total|memory_working_set_bytes|spec_memory_limit_bytes|network_receive_bytes_total|network_transmit_bytes_total|fs_reads_bytes_total|fs_writes_bytes_total|oom_events_total))"
              action = "keep"
            }
          }
        }

        prometheus.exporter.unix "node" {
          procfs_path    = "/host/proc"
          rootfs_path    = "/host/root"
          sysfs_path     = "/host/sys"
          udev_data_path = "/host/root/run/udev/data"

          filesystem {
            mount_points_exclude = "^/(dev|proc|sys|run/credentials/.+|var/lib/kubelet/.+|var/lib/rancher/k3s/.+)($|/)"
            mount_timeout        = "5s"
          }
        }

        discovery.relabel "node" {
          targets = prometheus.exporter.unix.node.targets
          rule {
            target_label = "instance"
            replacement  = sys.env("GCLOUD_FM_COLLECTOR_ID")
          }
          rule {
            target_label = "job"
            replacement  = "integrations/node_exporter"
          }
        }

        prometheus.scrape "node" {
          targets         = discovery.relabel.node.output
          scrape_interval = "15s"
          forward_to      = [prometheus.relabel.node.receiver]
        }

        prometheus.relabel "node" {
          forward_to = [prometheus.remote_write.grafana_cloud.receiver]
          rule {
            source_labels = ["__name__"]
            regex         = "node_scrape_collector_.+"
            action        = "drop"
          }
        }

        prometheus.scrape "kubelet" {
          targets = [{
            "__address__"      = "kubernetes.default.svc:443",
            "__metrics_path__" = "/api/v1/nodes/" + sys.env("NODE_NAME") + "/proxy/metrics",
            "instance"         = sys.env("GCLOUD_FM_COLLECTOR_ID"),
          }]
          scheme            = "https"
          bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
          tls_config {
            ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
          }
          job_name        = "kubelet"
          scrape_interval = "30s"
          forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
        }

        // Use the API server's verified TLS endpoint to reach this node's kubelet.
        prometheus.scrape "cadvisor" {
          targets = [{
            "__address__"      = "kubernetes.default.svc:443",
            "__metrics_path__" = "/api/v1/nodes/" + sys.env("NODE_NAME") + "/proxy/metrics/cadvisor",
            "instance"         = sys.env("GCLOUD_FM_COLLECTOR_ID"),
          }]
          scheme            = "https"
          bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
          tls_config {
            ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
          }
          job_name        = "integrations/cadvisor"
          scrape_interval = "15s"
          forward_to      = [prometheus.relabel.cadvisor.receiver]
        }

        prometheus.relabel "cadvisor" {
          forward_to = [prometheus.remote_write.grafana_cloud.receiver]
          rule {
            source_labels = ["namespace"]
            regex         = ""
            action        = "drop"
          }
          // Keep pod network metrics, including the sandbox, under the workload name.
          rule {
            source_labels = ["container"]
            target_label  = "service"
          }
          rule {
            source_labels = ["pod"]
            regex         = "(.+)-[a-z0-9]+-[a-z0-9]+"
            target_label  = "service"
            replacement   = "$1"
          }
          rule {
            source_labels = ["pod"]
            regex         = "(.+)-[0-9]+"
            target_label  = "service"
            replacement   = "$1"
          }
        }

        prometheus.scrape "agent_studio" {
          targets = [{
            "__address__" = "agent-studio.agent-studio.svc:80",
            "instance"    = sys.env("GCLOUD_FM_COLLECTOR_ID"),
          }]
          metrics_path    = "/api/metrics"
          job_name        = "agent-studio"
          scrape_interval = "15s"
          forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
        }

        prometheus.scrape "agent_memory" {
          targets = [{
            "__address__" = "agent-memory.agent-memory.svc:80",
            "instance"    = sys.env("GCLOUD_FM_COLLECTOR_ID"),
          }]
          metrics_path    = "/api/metrics"
          bearer_token    = sys.env("AGENT_MEMORY_METRICS_BEARER_TOKEN")
          job_name        = "agent-memory"
          scrape_interval = "15s"
          forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
        }

    extraEnv:
      - name: GCLOUD_FM_COLLECTOR_ID
        value: "{{cluster}}"
      - name: NODE_NAME
        valueFrom:
          fieldRef:
            fieldPath: spec.nodeName
    envFrom:
      - secretRef:
          name: alloy-grafana-cloud
    mounts:
      varlog: false
      extra:
        - name: alloy-data
          mountPath: /var/lib/alloy
        - name: host-proc
          mountPath: /host/proc
          readOnly: true
        - name: host-sys
          mountPath: /host/sys
          readOnly: true
        - name: host-root
          mountPath: /host/root
          readOnly: true
          mountPropagation: HostToContainer
{% if resources is defined and not resources.enabled %}
    resources: null
{% endif %}

  rbac:
    rules:
      - apiGroups: [""]
        resources: ["nodes"]
        verbs: ["get"]
    clusterRules:
      - apiGroups: [""]
        resources: ["nodes/proxy"]
        verbs: ["get"]

{% if resources is defined and not resources.enabled %}
  configReloader:
    resources: null
{% endif %}

  controller:
    type: daemonset
    priorityClassName: null
    hostNetwork: true
    dnsPolicy: ClusterFirstWithHostNet

    volumes:
      extra:
        - name: alloy-data
          hostPath:
            path: /var/lib/alloy
            type: DirectoryOrCreate
        - name: host-proc
          hostPath:
            path: /proc
        - name: host-sys
          hostPath:
            path: /sys
        - name: host-root
          hostPath:
            path: /

  extraObjects:
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: alloy-grafana-cloud
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: alloy-grafana-cloud
          creationPolicy: Owner
        data:
          - secretKey: GCLOUD_RW_API_KEY
            remoteRef:
              key: /k8s/common/grafana-cloud/remote-write-api-key
          - secretKey: AGENT_MEMORY_METRICS_BEARER_TOKEN
            remoteRef:
              key: /k8s/{{cluster}}/agent-memory/metrics-bearer-token
{% endif %}
