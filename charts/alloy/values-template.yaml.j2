alloy:
  fullnameOverride: alloy

{% if loki is defined and grafana_cloud is not defined %}
  alloy:
    configMap:
      content: |
{% include 'logs.alloy.j2' %}

  rbac:
    # The chart concatenates both lists; an empty list breaks its ClusterRole YAML.
    rules:
      - apiGroups: [""]
        resources: ["pods"]
        verbs: ["get"]
    clusterRules:
      - apiGroups: [""]
        resources: ["pods"]
        verbs: ["list", "watch"]
{%- endif %}

{%- if grafana_cloud is defined %}
{%- set cloud_metric_allowlist = 'integrations/node_exporter;.+|agent-studio;.+|agent-memory;.+|agent-librio;.+|agent-forge;.+|workspace-state;(up|kube_(pod_status_phase|pod_container_status_last_terminated_reason|resourcequota|node_labels|node_status_condition|deployment_status_replicas_available|deployment_spec_replicas))|kubelet;(up|kubelet_(node_name|running_pods|running_containers|volume_stats_.+|runtime_operations_(total|errors_total)))|integrations/cadvisor;(up|container_(cpu_usage_seconds_total|memory_working_set_bytes|spec_memory_limit_bytes|network_receive_bytes_total|network_transmit_bytes_total|fs_usage_bytes|fs_limit_bytes|fs_reads_bytes_total|fs_writes_bytes_total|oom_events_total))' %}
  alloy:
    configMap:
      content: |
{% if loki is defined %}
{% include 'logs.alloy.j2' %}
{% endif %}
{% if prometheus.remote_write_url is defined %}
        // Cluster metrics are scraped by Prometheus; forward only application metrics.
        prometheus.remote_write "local" {
          external_labels = { "cluster" = "{{cluster}}" }
          endpoint {
            url = "{{prometheus.remote_write_url}}"
            write_relabel_config {
              source_labels = ["job"]
              regex = "agent-(studio|memory|librio|forge)"
              action = "keep"
            }
          }
        }
{% endif %}
        prometheus.remote_write "grafana_cloud" {
          external_labels = { "cluster" = "{{cluster}}" }

          endpoint {
            url = "{{grafana_cloud.remote_write_url}}"
            basic_auth {
              username = "{{grafana_cloud.remote_write_username}}"
              password = sys.env("GCLOUD_RW_API_KEY")
            }

            // Apply the same policy to any samples replayed from the existing WAL.
            write_relabel_config {
              source_labels = ["job", "__name__"]
              regex = "{{cloud_metric_allowlist}}"
              action = "keep"
            }


          }
        }

        // Filter before remote_write: discarded series must not enter its WAL or caches.
        prometheus.relabel "retained_metrics" {
          forward_to = [prometheus.remote_write.grafana_cloud.receiver{% if prometheus.remote_write_url is defined %}, prometheus.remote_write.local.receiver{% endif %}]
          rule {
            source_labels = ["job", "__name__"]
            regex = "{{cloud_metric_allowlist}}"
            action = "keep"
          }
        }

        prometheus.exporter.unix "node" {
          procfs_path    = "/host/proc"
          rootfs_path    = "/host/root"
          sysfs_path     = "/host/sys"
          udev_data_path = "/host/root/run/udev/data"

          filesystem {
            mount_points_exclude = "^/(dev|proc|sys|run/credentials/.+|var/lib/kubelet/.+|var/lib/rancher/k3s/.+)($|/)"
            mount_timeout        = "5s"
          }
        }

        discovery.relabel "node" {
          targets = prometheus.exporter.unix.node.targets
          rule {
            target_label = "instance"
            replacement  = sys.env("GCLOUD_FM_COLLECTOR_ID")
          }
          rule {
            target_label = "job"
            replacement  = "integrations/node_exporter"
          }
        }

        prometheus.scrape "node" {
          targets         = discovery.relabel.node.output
          scrape_interval = "15s"
          forward_to      = [prometheus.relabel.node.receiver]
        }

        prometheus.relabel "node" {
          forward_to = [prometheus.relabel.retained_metrics.receiver]
          rule {
            source_labels = ["__name__"]
            regex         = "node_scrape_collector_.+"
            action        = "drop"
          }
        }

        prometheus.scrape "kubelet" {
          targets = [{
            "__address__"      = "kubernetes.default.svc:443",
            "__metrics_path__" = "/api/v1/nodes/" + sys.env("NODE_NAME") + "/proxy/metrics",
            "instance"         = sys.env("GCLOUD_FM_COLLECTOR_ID"),
          }]
          scheme            = "https"
          bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
          tls_config {
            ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
          }
          job_name        = "kubelet"
          scrape_interval = "30s"
          forward_to      = [prometheus.relabel.retained_metrics.receiver]
        }

        // Use the API server's verified TLS endpoint to reach this node's kubelet.
        prometheus.scrape "cadvisor" {
          targets = [{
            "__address__"      = "kubernetes.default.svc:443",
            "__metrics_path__" = "/api/v1/nodes/" + sys.env("NODE_NAME") + "/proxy/metrics/cadvisor",
            "instance"         = sys.env("GCLOUD_FM_COLLECTOR_ID"),
          }]
          scheme            = "https"
          bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
          tls_config {
            ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
          }
          job_name        = "integrations/cadvisor"
          scrape_interval = "15s"
          forward_to      = [prometheus.relabel.cadvisor.receiver]
        }

        prometheus.relabel "cadvisor" {
          forward_to = [prometheus.relabel.retained_metrics.receiver]
          rule {
            source_labels = ["namespace"]
            regex         = ""
            action        = "drop"
          }
          // Keep pod network metrics, including the sandbox, under the workload name.
          rule {
            source_labels = ["container"]
            target_label  = "service"
          }
          rule {
            source_labels = ["pod"]
            regex         = "(.+)-[a-z0-9]+-[a-z0-9]+"
            target_label  = "service"
            replacement   = "$1"
          }
          rule {
            source_labels = ["pod"]
            regex         = "(.+)-[0-9]+"
            target_label  = "service"
            replacement   = "$1"
          }
          // Node-level cAdvisor samples have no Pod discovery labels.
          rule {
            source_labels = ["namespace", "pod"]
            separator     = ";"
            regex         = "agent-forge-workspaces;forge-ws-[a-f0-9]{40}-[a-z0-9]{5}"
            target_label  = "service"
            replacement   = "agent-forge-sandbox"
          }
        }

        prometheus.scrape "workspace_state" {
          targets = [{ "__address__" = "workspace-metrics.addon-workspace-metrics.svc.cluster.local:8080" }]
          job_name        = "workspace-state"
          scrape_interval = "15s"
          forward_to      = [prometheus.relabel.retained_metrics.receiver]
        }

        prometheus.scrape "agent_studio" {
          targets = [{
            "__address__" = "agent-studio.agent-studio.svc:3000",
            "namespace"   = "agent-studio",
            "instance"    = sys.env("GCLOUD_FM_COLLECTOR_ID"),
          }]
          metrics_path    = "/api/metrics"
          bearer_token    = sys.env("AGENT_STUDIO_METRICS_BEARER_TOKEN")
          job_name        = "agent-studio"
          scrape_interval = "15s"
          forward_to      = [prometheus.relabel.retained_metrics.receiver]
        }

        prometheus.scrape "agent_memory" {
          targets = [{
            "__address__" = "agent-memory.agent-memory.svc:3000",
            "namespace"   = "agent-memory",
            "instance"    = sys.env("GCLOUD_FM_COLLECTOR_ID"),
          }]
          metrics_path    = "/api/metrics"
          bearer_token    = sys.env("AGENT_MEMORY_METRICS_BEARER_TOKEN")
          job_name        = "agent-memory"
          scrape_interval = "15s"
          forward_to      = [prometheus.relabel.retained_metrics.receiver]
        }

        prometheus.scrape "agent_librio" {
          targets = [{
            "__address__" = "agent-librio.agent-librio.svc:3000",
            "instance"    = sys.env("GCLOUD_FM_COLLECTOR_ID"),
            "namespace"   = "agent-librio",
            "component"   = "web",
          }, {
            "__address__" = "agent-librio-worker.agent-librio.svc:3000",
            "instance"    = sys.env("GCLOUD_FM_COLLECTOR_ID"),
            "namespace"   = "agent-librio",
            "component"   = "worker",
          }]
          metrics_path    = "/api/metrics"
          bearer_token    = sys.env("AGENT_LIBRIO_METRICS_BEARER_TOKEN")
          job_name        = "agent-librio"
          scrape_interval = "15s"
          forward_to      = [prometheus.relabel.retained_metrics.receiver]
        }

        prometheus.scrape "agent_forge" {
          targets = [{
            "__address__" = "agent-forge.agent-forge.svc:3103",
            "instance"    = sys.env("GCLOUD_FM_COLLECTOR_ID"),
            "namespace"   = "agent-forge",
          }]
          metrics_path    = "/metrics"
          bearer_token    = sys.env("AGENT_FORGE_METRICS_BEARER_TOKEN")
          job_name        = "agent-forge"
          scrape_interval = "15s"
          forward_to      = [prometheus.relabel.retained_metrics.receiver]
        }

    extraEnv:
      - name: GCLOUD_FM_COLLECTOR_ID
        value: "{{cluster}}"
      - name: NODE_NAME
        valueFrom:
          fieldRef:
            fieldPath: spec.nodeName
    envFrom:
      - secretRef:
          name: alloy-grafana-cloud
    mounts:
      varlog: {{ loki is defined }}
      extra:
        - name: alloy-data
          mountPath: /var/lib/alloy
        - name: host-proc
          mountPath: /host/proc
          readOnly: true
        - name: host-sys
          mountPath: /host/sys
          readOnly: true
        - name: host-root
          mountPath: /host/root
          readOnly: true
          mountPropagation: HostToContainer
{% if resources is defined and not resources.enabled %}
    resources: null
{% endif %}

  rbac:
    rules:
      - apiGroups: [""]
        resources: ["nodes"]
        verbs: ["get"]
    clusterRules:
      - apiGroups: [""]
        resources: ["nodes/proxy"]
        verbs: ["get"]
{% if loki is defined %}
      - apiGroups: [""]
        resources: ["pods"]
        verbs: ["get", "list", "watch"]
{% endif %}

{% if resources is defined and not resources.enabled %}
  configReloader:
    resources: null
{% endif %}

  controller:
    type: daemonset
    priorityClassName: null
    hostNetwork: true
    dnsPolicy: ClusterFirstWithHostNet

    volumes:
      extra:
        - name: alloy-data
          hostPath:
            path: /var/lib/alloy
            type: DirectoryOrCreate
        - name: host-proc
          hostPath:
            path: /proc
        - name: host-sys
          hostPath:
            path: /sys
        - name: host-root
          hostPath:
            path: /

{% endif %}

{%- if (env == 'eks' and alloy_network_policy is defined and loki is defined) or grafana_cloud is defined or (vibemon is defined and vibemon.enabled) %}
raw:
  resources:
{%- if env == 'eks' and alloy_network_policy is defined and loki is defined %}
    # Auto Mode DefaultDeny also applies to infrastructure DaemonSets.
    # DNS rules follow Loki's load balancer addresses without allowing all HTTP.
    - apiVersion: networking.k8s.aws/v1alpha1
      kind: ApplicationNetworkPolicy
      metadata:
        name: alloy-network
      spec:
        podSelector:
          matchLabels:
            app.kubernetes.io/name: alloy
            app.kubernetes.io/instance: alloy
        policyTypes:
          - Ingress
          - Egress
        ingress:
          - from:
{%- for cidr in alloy_network_policy.node_cidrs %}
              - ipBlock:
                  cidr: {{cidr}}
{%- endfor %}
            ports:
              - protocol: TCP
                port: 12345
        egress:
          - to:
{%- for cidr in alloy_network_policy.dns_cidrs %}
              - ipBlock:
                  cidr: {{cidr}}
{%- endfor %}
            ports:
              - protocol: UDP
                port: 53
              - protocol: TCP
                port: 53
          - to:
{%- for cidr in alloy_network_policy.api_server_cidrs %}
              - ipBlock:
                  cidr: {{cidr}}
{%- endfor %}
            ports:
              - protocol: TCP
                port: 443
          - to:
              - domainNames:
                  - {{loki.hostname}}
            ports:
              - protocol: TCP
                port: 80
{%- endif %}
{%- if grafana_cloud is defined %}
{%- set cloud_metric_allowlist = 'integrations/node_exporter;.+|agent-studio;.+|agent-memory;.+|agent-librio;.+|agent-forge;.+|workspace-state;(up|kube_(pod_status_phase|pod_container_status_last_terminated_reason|resourcequota|node_labels|node_status_condition|deployment_status_replicas_available|deployment_spec_replicas))|kubelet;(up|kubelet_(node_name|running_pods|running_containers|volume_stats_.+|runtime_operations_(total|errors_total)))|integrations/cadvisor;(up|container_(cpu_usage_seconds_total|memory_working_set_bytes|spec_memory_limit_bytes|network_receive_bytes_total|network_transmit_bytes_total|fs_usage_bytes|fs_limit_bytes|fs_reads_bytes_total|fs_writes_bytes_total|oom_events_total))' %}
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: alloy-grafana-cloud
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: alloy-grafana-cloud
          creationPolicy: Owner
        data:
          - secretKey: GCLOUD_RW_API_KEY
            remoteRef:
              key: /k8s/common/grafana-cloud/remote-write-api-key
          - secretKey: AGENT_STUDIO_METRICS_BEARER_TOKEN
            remoteRef:
              key: /k8s/{{cluster}}/agent-studio/metrics-bearer-token
          - secretKey: AGENT_MEMORY_METRICS_BEARER_TOKEN
            remoteRef:
              key: /k8s/{{cluster}}/agent-memory/metrics-bearer-token
          - secretKey: AGENT_LIBRIO_METRICS_BEARER_TOKEN
            remoteRef:
              key: /k8s/{{cluster}}/agent-librio/metrics-bearer-token
          - secretKey: AGENT_FORGE_METRICS_BEARER_TOKEN
            remoteRef:
              key: /k8s/{{cluster}}/agent-forge/metrics-bearer-token
{%- endif %}
{% if vibemon is defined and vibemon.enabled %}
{% include 'vibemon-resources.yaml.j2' %}
{%- endif %}
{%- endif %}
