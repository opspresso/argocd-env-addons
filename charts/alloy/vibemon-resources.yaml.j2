    - apiVersion: v1
      kind: ServiceAccount
      metadata:
        name: vibemon-collector
    - apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: vibemon-collector-{{cluster}}
      rules:
        - apiGroups: [""]
          resources: ["nodes", "pods"]
          verbs: ["list"]
        - apiGroups: ["metrics.k8s.io"]
          resources: ["nodes"]
          verbs: ["get", "list"]
    - apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: vibemon-collector-{{cluster}}
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: ClusterRole
        name: vibemon-collector-{{cluster}}
      subjects:
        - kind: ServiceAccount
          name: vibemon-collector
          namespace: addon-alloy
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: vibemon-collector
      spec:
        refreshInterval: 5m
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: vibemon-collector
          creationPolicy: Owner
        data:
          - secretKey: VIBEMON_WRITE_TOKEN
            remoteRef:
              key: /k8s/{{cluster}}/vibemon/write-token
    - apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: vibemon-collector
      spec:
        replicas: 1
        strategy:
          type: Recreate
        selector:
          matchLabels:
            app.kubernetes.io/name: vibemon-collector
        template:
          metadata:
            labels:
              app.kubernetes.io/name: vibemon-collector
            annotations:
              sidecar.istio.io/inject: "false"
          spec:
            serviceAccountName: vibemon-collector
            nodeSelector:
              kubernetes.io/os: linux
            securityContext:
              runAsNonRoot: true
              runAsUser: 65532
              runAsGroup: 65532
              fsGroup: 65532
              seccompProfile:
                type: RuntimeDefault
            containers:
              - name: collector
                image: {{vibemon.image}}
                args:
                  - --source-id
                  - {{cluster}}
                  - --name
                  - {{vibemon.display_name | tojson}}
                  - --kind
                  - cluster
                  - --cluster-backend
                  - metrics-api
                  - --kubectl-command
                  - kubectl --cache-dir=/tmp/kubectl
                  - --url
                  - https://{{vibemon.hostname}}
                  - --health-file
                  - /tmp/vibemon-health
                env:
                  - name: VIBEMON_WRITE_TOKEN
                    valueFrom:
                      secretKeyRef:
                        name: vibemon-collector
                        key: VIBEMON_WRITE_TOKEN
                securityContext:
                  allowPrivilegeEscalation: false
                  readOnlyRootFilesystem: true
                  capabilities:
                    drop: ["ALL"]
{% if resources.enabled %}
                resources:
                  requests:
                    cpu: 25m
                    memory: 64Mi
                  limits:
                    memory: 192Mi
{% endif %}
                readinessProbe:
                  exec:
                    command: ["python", "-m", "vibemon_collector.health", "/tmp/vibemon-health"]
                  initialDelaySeconds: 30
                  periodSeconds: 10
                  timeoutSeconds: 2
                  failureThreshold: 1
                volumeMounts:
                  - name: temporary
                    mountPath: /tmp
            volumes:
              - name: temporary
                emptyDir:
                  sizeLimit: 32Mi
{% if env == 'eks' %}
    - apiVersion: networking.k8s.aws/v1alpha1
      kind: ApplicationNetworkPolicy
      metadata:
        name: vibemon-collector-network
      spec:
        podSelector:
          matchLabels:
            app.kubernetes.io/name: vibemon-collector
        policyTypes: ["Ingress", "Egress"]
        ingress: []
        egress:
          - to:
{% for cidr in alloy_network_policy.dns_cidrs %}
              - ipBlock:
                  cidr: {{cidr}}
{% endfor %}
            ports:
              - protocol: UDP
                port: 53
              - protocol: TCP
                port: 53
          - to:
{% for cidr in alloy_network_policy.api_server_cidrs %}
              - ipBlock:
                  cidr: {{cidr}}
{% endfor %}
            ports:
              - protocol: TCP
                port: 443
          - to:
              - domainNames:
                  - {{vibemon.hostname}}
            ports:
              - protocol: TCP
                port: 443
{% endif %}
