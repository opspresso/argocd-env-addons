argo-cd:
  fullnameOverride: argocd
{% if argocd is defined %}
  controller:
    metrics:
      serviceMonitor:
        enabled: {{prometheus.serviceMonitor.enabled}}
        selector:
          release: prometheus-{{cluster}}
{% if resources is defined and not resources.enabled %}
    resources: null
{% endif %}

  server:
    replicas: {{argocd.replicas.server}}
{% if resources is defined and not resources.enabled %}
    resources: null
{% endif %}
{% if autoscaling is defined and not autoscaling.enabled %}
    autoscaling:
      enabled: false
{% endif %}
    ingress:
      enabled: false
      hostname: "{{argocd.hostname}}"
      annotations:
        kubernetes.io/ingress.class: "alb"
        external-dns.alpha.kubernetes.io/hostname: "{{argocd.hostname}}"
        alb.ingress.kubernetes.io/scheme: "internet-facing"
        alb.ingress.kubernetes.io/target-type: "ip"
        alb.ingress.kubernetes.io/listen-ports: '[{"HTTPS":443}]'
        alb.ingress.kubernetes.io/certificate-arn: "{{argocd.acm_arn | default('')}}"
        alb.ingress.kubernetes.io/actions.ssl-redirect: |
          {"Type": "redirect", "RedirectConfig": {"Protocol": "HTTPS", "Port": "443", "StatusCode": "HTTP_301"}}

    httproute:
      enabled: {{argocd.http_route.enabled}}
      parentRefs:
{{argocd.http_route.parent_refs | to_yaml | indent(8, first=true)}}
      hostnames:
        - "{{argocd.hostname}}"

    metrics:
      serviceMonitor:
        enabled: {{prometheus.serviceMonitor.enabled}}
        selector:
          release: prometheus-{{cluster}}

  repoServer:
    replicas: {{argocd.replicas.repo_server}}
{% if resources is defined and not resources.enabled %}
    resources: null
{% endif %}
{% if autoscaling is defined and not autoscaling.enabled %}
    autoscaling:
      enabled: false
{% endif %}
    metrics:
      serviceMonitor:
        enabled: {{prometheus.serviceMonitor.enabled}}
        selector:
          release: prometheus-{{cluster}}

  applicationSet:
    replicas: {{argocd.replicas.application_set}}
{% if resources is defined and not resources.enabled %}
    resources: null
{% endif %}

  dex:
    enabled: {{argocd.dex.enabled}}
{% if resources is defined and not resources.enabled %}
    resources: null
{% endif %}
    metrics:
      serviceMonitor:
        enabled: {{prometheus.serviceMonitor.enabled}}
        selector:
          release: prometheus-{{cluster}}

{% if resources is defined and not resources.enabled %}
  redis:
    resources: null
  redisSecretInit:
    resources: null
{% endif %}

  notifications:
    enabled: {{argocd.notifications.enabled}}
    argocdUrl: {{argocd.scheme | default('https')}}://{{argocd.hostname}}
    # Report outcomes only. Every GitOps commit syncs many apps, so the
    # running and succeeded triggers flooded the channel.
    subscriptions:
      - recipients:
          - slack:noti-{{cluster}}
        triggers:
          - on-deployed
          - on-health-degraded
          - on-sync-failed
          - on-sync-status-unknown
{% if resources is defined and not resources.enabled %}
    resources: null
{% endif %}

  configs:
    rbac:
      policy.default: "role:readonly"

      # mcp-argocd can mutate every Application, including Argo CD itself.
      # With the current unrestricted AppProjects, updating Helm values and
      # syncing can change cluster resources and RBAC. Treat this API token
      # as an administrative credential; the named role is not a sandbox.
      # Read-only access requires removing create/update/delete/sync/action
      # grants here and in install/eks/values.yaml. MCP_READ_ONLY only hides tools.
      # Every account inherits policy.default; deny rules cannot remove those
      # default grants. Narrower reads require a smaller default role first.
      policy.csv: |
        g, {{argocd.github.org}}:{{argocd.github.team}}, role:admin

        p, role:mcp, applications, get, */*, allow
        p, role:mcp, applications, create, */*, allow
        p, role:mcp, applications, update, */*, allow
        p, role:mcp, applications, delete, */*, allow
        p, role:mcp, applications, sync, */*, allow
        p, role:mcp, applications, action/*, */*, allow
        p, role:mcp, logs, get, */*, allow
        p, role:mcp, projects, get, *, allow
        p, role:mcp, clusters, get, *, allow
        g, mcp, role:mcp

    cm:
      url: {{argocd.scheme | default('https')}}://{{argocd.hostname}}

      statusbadge.url: {{argocd.scheme | default('https')}}://{{argocd.hostname}}/

      help.chatUrl: "{{argocd.chatUrl}}"
      help.chatText: "Chat now!"

      # Local account for mcp-argocd. `apiKey` and not `login`: it may mint API
      # tokens but cannot sign in, so there is no password on it to guess and it
      # never turns into a UI session.
      accounts.mcp: apiKey

      dex.config: |
        connectors:
        - type: github
          id: github
          name: github
          config:
            clientID: $dex.github.clientId
            clientSecret: $dex.github.clientSecret
            teamNameField: slug
            orgs:
              - name: {{argocd.github.org}}
        staticClients:
        - id: argo-workflows-sso
          name: Argo Workflow
          redirectURIs:
            - https://workflows.{{hostname.public}}/oauth2/callback
          secretEnv: ARGO_WORKFLOWS_SSO_CLIENT_SECRET
        - id: oauth2-proxy-sso
          name: OAuth2 Proxy
          redirectURIs:
            - https://auth.{{hostname.public}}/oauth2/callback
          secretEnv: OAUTH2_PROXY_SSO_CLIENT_SECRET

{% endif %}

{% if external_secrets | default(true) %}
raw:
  resources:
    - apiVersion: argoproj.io/v1alpha1
      kind: AppProject
      metadata:
        name: addons
      spec:
        clusterResourceWhitelist:
          - group: "*"
            kind: "*"
        destinations:
          - name: "*"
            namespace: "*"
            server: "*"
        sourceRepos:
          - "https://github.com/opspresso/argocd-env-addons"

    - apiVersion: argoproj.io/v1alpha1
      kind: AppProject
      metadata:
        name: apps
      spec:
        clusterResourceWhitelist:
          - group: "*"
            kind: "*"
        destinations:
          - name: "*"
            namespace: "*"
            server: "*"
        sourceRepos:
          - "https://github.com/opspresso/argocd-env-apps"
{%- if app_delivery is defined and app_delivery.enabled %}

    # Apps that Agent Delivery deploys (agent-platform docs/APP_DELIVERY.md, docs/DELIVERY_V2.md). The app-deploy and
    # resource-sync workflows write argocd-env-projects projects/<slug>/<env>/{app,resources}.yaml; these Applications
    # may only create the kinds the app chart renders and the platform kro instances, in app-* namespaces other than
    # app-delivery.
    - apiVersion: argoproj.io/v1alpha1
      kind: AppProject
      metadata:
        name: projects
      spec:
        description: One Application per Agent Delivery Project environment
        sourceRepos:
          - "https://github.com/opspresso/argocd-env-projects.git"
        destinations:
          - name: "{{cluster}}"
            namespace: "app-*"
          - name: "*"
            namespace: "!app-delivery"
        clusterResourceWhitelist:
          - group: ""
            kind: Namespace
        namespaceResourceWhitelist:
          - {group: "", kind: ServiceAccount}
          - {group: "", kind: Service}
          - {group: "", kind: ResourceQuota}
          - {group: apps, kind: Deployment}
          - {group: autoscaling, kind: HorizontalPodAutoscaler}
          - {group: policy, kind: PodDisruptionBudget}
          - {group: networking.k8s.io, kind: NetworkPolicy}
          - {group: gateway.networking.k8s.io, kind: HTTPRoute}
          - {group: external-secrets.io, kind: SecretStore}
          - {group: external-secrets.io, kind: ExternalSecret}
          # Instances of the platform ResourceGraphDefinitions (charts/kro); resource-sync writes only these kinds.
          - {group: kro.run, kind: RdsPostgres}

    # The app-build, app-deploy and resource-sync WorkflowTemplates, their step identities and Agent Delivery's submit
    # permission.
    - apiVersion: argoproj.io/v1alpha1
      kind: AppProject
      metadata:
        name: delivery
      spec:
        description: The Argo Workflows delivery of Agent Delivery apps
        sourceRepos:
          - "https://github.com/opspresso/argocd-env-projects.git"
        destinations:
          - name: "{{cluster}}"
            namespace: app-delivery
        clusterResourceWhitelist:
          - {group: "", kind: Namespace}
          - {group: rbac.authorization.k8s.io, kind: ClusterRole}
          - {group: rbac.authorization.k8s.io, kind: ClusterRoleBinding}
        namespaceResourceWhitelist:
          - {group: "", kind: ServiceAccount}
          - {group: "", kind: ConfigMap}
          # The executor-only ServiceAccount token of the runner steps.
          - {group: "", kind: Secret}
          - {group: rbac.authorization.k8s.io, kind: Role}
          - {group: rbac.authorization.k8s.io, kind: RoleBinding}
          - {group: networking.k8s.io, kind: NetworkPolicy}
          - {group: external-secrets.io, kind: ExternalSecret}
          - {group: argoproj.io, kind: WorkflowTemplate}

    - apiVersion: argoproj.io/v1alpha1
      kind: Application
      metadata:
        name: app-delivery
        labels:
          opspresso.com/cluster: "{{cluster}}"
          opspresso.com/group: "projects"
      spec:
        project: delivery
        destination:
          name: "{{cluster}}"
          namespace: app-delivery
        source:
          repoURL: https://github.com/opspresso/argocd-env-projects.git
          targetRevision: HEAD
          path: charts/delivery
          helm:
            valuesObject:
              registry: "{{aws_account_id}}.dkr.ecr.{{aws_region}}.amazonaws.com/projects"
              pushRoleArn: "arn:aws:iam::{{aws_account_id}}:role/app-delivery-push"
              region: "{{aws_region}}"
              apiServer:
                cidrs: {{ app_delivery.api_server_cidrs | tojson }}
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
          syncOptions:
            - CreateNamespace=true

    # One Application per projects/<slug>/<env> directory of an allowed environment. Project, environment, namespace
    # and host come from the directory path and the environment profile of this cluster, not from the files, and the
    # charts/app guard checks them. A values file could still turn the guard off: the boundary is that only the
    # app-deploy step writes app.yaml, through the fixed render.jq mapping, with a deploy key that only the delivery-git
    # steps hold. The Application syncs the app chart with app.yaml (tenant objects only until the first deployment)
    # and the kro instances in resources.yaml.
    - apiVersion: argoproj.io/v1alpha1
      kind: ApplicationSet
      metadata:
        name: projects
      spec:
        goTemplate: true
        goTemplateOptions: ["missingkey=error"]
        generators:
          - git:
              repoURL: https://github.com/opspresso/argocd-env-projects.git
              revision: HEAD
              requeueAfterSeconds: 30
              directories:
{%- for environment in app_delivery.environments %}
                - path: "projects/*/{{environment}}"
{%- endfor %}
        template:
          metadata:
            name: '{% raw %}app-{{ index .path.segments 1 }}-{{ .path.basename }}{% endraw %}'
            labels:
              opspresso.com/cluster: "{{cluster}}"
              opspresso.com/group: "projects"
              opspresso.com/delivery-project: '{% raw %}{{ index .path.segments 1 }}{% endraw %}'
              opspresso.com/delivery-env: '{% raw %}{{ .path.basename }}{% endraw %}'
          spec:
            project: projects
            destination:
              name: "{{cluster}}"
              namespace: '{% raw %}app-{{ index .path.segments 1 }}-{{ .path.basename }}{% endraw %}'
            sources:
              - repoURL: https://github.com/opspresso/argocd-env-projects.git
                targetRevision: HEAD
                path: charts/app
                helm:
                  valueFiles:
                    - '{% raw %}../../{{ .path.path }}/app.yaml{% endraw %}'
                  # resources.yaml may come before the first deployment writes app.yaml.
                  ignoreMissingValueFiles: true
                  # charts/app wraps the opspresso app chart; its guard refuses any other environment, namespace or host.
                  parameters:
                    - name: app.tenant.project
                      value: '{% raw %}{{ index .path.segments 1 }}{% endraw %}'
                    - name: app.tenant.environment
                      value: '{% raw %}{{ .path.basename }}{% endraw %}'
                    - name: app.tenant.environments
                      value: "{{ app_delivery.environments | join(' ') }}"
                    - name: app.tenant.primaryEnvironment
                      value: "{{app_delivery.primary_environment}}"
                    - name: app.tenant.domain
                      value: "{{app_delivery.domain}}"
                    - name: app.tenant.cluster
                      value: "{{cluster}}"
                    - name: app.tenant.region
                      value: "{{aws_region}}"
                    - name: app.tenant.tenantSecretsRoleArn
                      value: "arn:aws:iam::{{aws_account_id}}:role/agent-delivery-tenant-secrets"
                    - name: app.routing.hosts[0]
                      value: '{% raw %}{{ if eq .path.basename "{% endraw %}{{app_delivery.primary_environment}}{% raw %}" }}{{ index .path.segments 1 }}{{ else }}{{ index .path.segments 1 }}-{{ .path.basename }}{{ end }}{% endraw %}.{{app_delivery.domain}}'
              # The namespaced resources (kro instances) that resource-sync writes; AppProject projects limits the kinds.
              - repoURL: https://github.com/opspresso/argocd-env-projects.git
                targetRevision: HEAD
                path: '{% raw %}{{ .path.path }}{% endraw %}'
                directory:
                  include: resources.yaml
            syncPolicy:
              automated:
                prune: true
                selfHeal: true
              syncOptions:
                - CreateNamespace=true
              # The Agent Delivery tenant secrets policy accepts the SecretStore only in a namespace with these labels.
              managedNamespaceMetadata:
                labels:
                  # Tenant Pods may not run privileged, share host namespaces or mount host paths.
                  pod-security.kubernetes.io/enforce: baseline
                  opspresso.com/delivery-tenant: "true"
                  opspresso.com/delivery-project: '{% raw %}{{ index .path.segments 1 }}{% endraw %}'
                  opspresso.com/delivery-env: '{% raw %}{{ .path.basename }}{% endraw %}'
{%- endif %}

    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: argocd-notifications-secret
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: argocd-notifications-secret
        data:
          - secretKey: slack-token
            remoteRef:
              key: /k8s/common/argocd-noti-token

    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: argocd-applicationset-secret
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: argocd-applicationset-secret
        data:
          - secretKey: webhook.github.secret
            remoteRef:
              key: /k8s/common/argocd-webhook

{%- if argocd is defined %}
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: argocd-secret
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: argocd-secret
        data:
          - secretKey: admin.password
            remoteRef:
              key: /k8s/common/argocd-password
          - secretKey: admin.passwordMtime
            remoteRef:
              key: /k8s/common/argocd-mtime
          - secretKey: dex.github.clientId
            remoteRef:
              key: /k8s/{{argocd.github.org}}/argocd-github-id
          - secretKey: dex.github.clientSecret
            remoteRef:
              key: /k8s/{{argocd.github.org}}/argocd-github-secret
          - secretKey: webhook.github.secret
            remoteRef:
              key: /k8s/common/argocd-webhook
          - secretKey: server.secretkey
            remoteRef:
              key: /k8s/common/argocd-server-secret
          # The `mcp` account's token list, seeded rather than left where Argo
          # CD puts it. `argocd account generate-token` writes the list into
          # this very Secret in-cluster, and this ExternalSecret owns the
          # Secret — so nothing in git would bring the list back after a
          # rebuild, and the token mcp-argocd holds would start answering 401
          # with no trace of why. Seeding it keeps both sides agreeing, the same
          # bargain admin.password already takes.
          #
          # install/token.sh writes this parameter, and install/values.yaml
          # seeds the same key at bootstrap. It must exist before this renders:
          # a missing parameter fails the whole ExternalSecret, so on a fresh
          # cluster argocd-secret would never appear at all.
          - secretKey: accounts.mcp.tokens
            remoteRef:
              key: /k8s/common/argocd-mcp-tokens
{% if argocd.google.enabled %}
          - secretKey: dex.google.clientId
            remoteRef:
              key: /common/google/client_id
          - secretKey: dex.google.clientSecret
            remoteRef:
              key: /common/google/client_secret
{% endif %}
          - secretKey: argo-workflows-client-secret
            remoteRef:
              key: /k8s/common/argo-workflows-client-secret
          - secretKey: oauth2-proxy-client-secret
            remoteRef:
              key: /k8s/common/oauth2-proxy-client-secret{% endif %}
{%- endif %}
