external-dns:
  fullnameOverride: external-dns

  # Without a filter external-dns manages every hosted zone the Pod Identity
  # role can reach, and policy=sync deletes records it considers stale.
  domainFilters:
    - {{hostname.public}}
    - {{hostname.internal}}

  # The default owner id is a literal "default", so two clusters would claim
  # each other's TXT registry entries.
  txtOwnerId: {{cluster}}
