{% if harbor is defined %}
harbor:
  externalURL: "https://{{harbor.hostname}}"
  nginx:
    podAnnotations:
      link.argocd.argoproj.io/external-link: "https://{{harbor.hostname}}"

raw:
  resources:
    # nginx of the chart routes the portal, the API and the registry (/v2/).
    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
        name: harbor
        annotations:
          link.argocd.argoproj.io/external-link: "https://{{harbor.hostname}}"
      spec:
        parentRefs:
          - group: gateway.networking.k8s.io
            kind: Gateway
{% if gateway is defined %}
            name: "{{gateway.name}}"
            namespace: "{{gateway.namespace}}"
{% else %}
            name: istio-ingressgateway
            namespace: istio-system
{% endif %}
        hostnames:
          - "{{harbor.hostname}}"
        rules:
          - backendRefs:
              - name: harbor
                port: 80

    # The chart sets the internal PostgreSQL and Valkey passwords only as plain
    # values (defaults). Only Pods of this namespace reach them.
    - apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata:
        name: harbor-data
      spec:
        podSelector:
          matchExpressions:
            - {key: app, operator: In, values: [harbor]}
            - {key: component, operator: In, values: [database, redis]}
        policyTypes: [Ingress]
        ingress:
          - from:
              - podSelector: {}

    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: harbor-secret
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: harbor-secret
        data:
          # Local admin. Harbor reads it only at the first start; it signs in to
          # the API and to the portal's local form, not through Dex.
          - secretKey: HARBOR_ADMIN_PASSWORD
            remoteRef:
              key: /k8s/common/harbor/admin-password
          # 16 characters. Encrypts the stored credentials; never change it.
          - secretKey: secretKey
            remoteRef:
              key: /k8s/common/harbor/secret-key

    # Sign-in through Argo CD Dex (client harbor-sso). Dex accepts only members of
    # {{argocd.github.org}}; members of {{argocd.github.org}}:{{argocd.github.team}} become Harbor
    # administrators. Core applies this JSON at every start.
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: harbor-oidc
      spec:
        refreshInterval: 1h
        secretStoreRef:
          kind: ClusterSecretStore
          name: parameter-store
        target:
          name: harbor-oidc
          template:
            engineVersion: v2
            data:
              CONFIG_OVERWRITE_JSON: >-
                {"auth_mode":"oidc_auth",
                "oidc_name":"GitHub",
                "oidc_endpoint":"https://{{argocd.hostname}}/api/dex",
                "oidc_client_id":"harbor-sso",
                "oidc_client_secret":"{{ '{{ .client_secret }}' }}",
                "oidc_scope":"openid,profile,email,groups,offline_access",
                "oidc_groups_claim":"groups",
                "oidc_admin_group":"{{argocd.github.org}}:{{argocd.github.team}}",
                "oidc_user_claim":"preferred_username",
                "oidc_verify_cert":true,
                "oidc_auto_onboard":true,
                "primary_auth_mode":true,
                "self_registration":false}
        data:
          - secretKey: client_secret
            remoteRef:
              key: /k8s/common/harbor/oidc-client-secret
{% else %}
# no cluster-specific overrides
{% endif %}
