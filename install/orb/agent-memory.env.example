# Merge these connection settings into agent-memory/.env.local.
# PostgreSQL and MinIO use /k8s/orb-demo/agent-studio/* SSM credentials.
# Neo4j uses /k8s/orb-demo/agent-memory/neo4j-auth (neo4j/PASSWORD).
DATABASE_URL=postgresql://agent_studio:REPLACE_POSTGRES_PASSWORD@postgres.agent-studio.svc.cluster.local:5432/agent_memory
S3_ENDPOINT=http://minio.agent-studio.svc.cluster.local:9000
S3_REGION=ap-northeast-2
S3_BUCKET=agent-memory
S3_ACCESS_KEY_ID=REPLACE_MINIO_ROOT_USER
S3_SECRET_ACCESS_KEY=REPLACE_MINIO_ROOT_PASSWORD
S3_FORCE_PATH_STYLE=true
NEO4J_URI=bolt://memory-neo4j.agent-memory.svc.cluster.local:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=REPLACE_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j
