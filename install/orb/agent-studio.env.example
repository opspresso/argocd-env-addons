# Merge these connection settings into agent-studio/.env.local.
# Use the matching /k8s/orb-demo/agent-studio/* SSM credentials.
DATABASE_URL=postgresql://agent_studio:REPLACE_POSTGRES_PASSWORD@postgres.agent-studio.svc.cluster.local:5432/agent_studio
S3_ENDPOINT=http://minio.agent-studio.svc.cluster.local:9000
S3_BUCKET_NAME=agent-studio
S3_ACCESS_KEY_ID=REPLACE_MINIO_ROOT_USER
S3_SECRET_ACCESS_KEY=REPLACE_MINIO_ROOT_PASSWORD
AWS_REGION=ap-northeast-2
ARTIFACT_ACCESS_MODE=proxied
MCP_INTERNAL_HOST_SUFFIXES=agent-mcps.svc.cluster.local,localhost
